{
  "name": "aevo-pos",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @aevo/api dev",
    "dev:web": "bun run --filter @aevo/web dev",
    "build": "bun run --filter '*' build",
    "deploy:web": "npm exec --yes --package=wrangler@4.132.0 -- wrangler deploy --config wrangler.jsonc",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages apps",
    "test:integration": "TEST_MONGODB_URI=${TEST_MONGODB_URI:-mongodb://localhost:27018} TEST_MONGODB_DATABASE=${TEST_MONGODB_DATABASE:-aevo_test} bun test packages/db/test",
    "db:migrate": "bun run --filter @aevo/db migrate",
    "db:seed": "bun run --filter @aevo/db seed"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
