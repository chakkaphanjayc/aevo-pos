{
  "name": "aevo-pos",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:tunnel": "AEVO_DEV_TUNNEL=1 bun run scripts/dev.ts",
    "dev:api": "bun --env-file=.env run --filter @aevo/api dev",
    "dev:modern": "bun --env-file=.env run --cwd apps/pos-modern dev",
    "dev:modern:tunnel": "AEVO_DEV_TUNNEL=1 bun --env-file=.env run --cwd apps/pos-modern dev",
    "build": "bun run --filter @aevo/api build && bun run --cwd apps/pos-modern build && bun run --filter @aevo/worker build",
    "deploy": "npm exec --yes --package=wrangler@4.132.0 -- wrangler deploy --config wrangler.jsonc",
    "deploy:web": "npm exec --yes --package=wrangler@4.132.0 -- wrangler deploy --config wrangler.jsonc",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "bun run --filter @aevo/api typecheck && bun run --cwd apps/pos-modern typecheck && bun run --filter @aevo/worker typecheck",
    "test": "AEVO_TEST_MODE=1 bun test packages apps",
    "test:integration": "AEVO_TEST_MODE=1 bun test packages/db/test apps/api/test",
    "db:migrate": "npx --yes supabase@2.117.0 db push",
    "db:migrate:supabase": "bun --env-file=.env run scripts/migrate-supabase.ts",
    "db:seed": "bun --env-file=.env run --filter @aevo/db seed"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
