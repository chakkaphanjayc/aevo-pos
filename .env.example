NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:4321
# Local development: frontend points to separately running API
PUBLIC_API_URL=http://localhost:3001
# Server-only Supabase key. Never expose this in apps/web or PUBLIC_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SESSION_COOKIE_NAME=aevo_pos_session
# Use "none" only when the web and API are on different sites; production must use HTTPS.
SESSION_COOKIE_SAME_SITE=lax
LOG_LEVEL=info
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
SEED_INITIAL_ROLE=OWNER
SEED_ORGANIZATION_NAME=Aevo Demo
SEED_STORE_NAME=Main Store
SEED_STORE_TIMEZONE=Asia/Bangkok
