NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:4321
# Use mongodb+srv://... for MongoDB Atlas; the local Docker value is convenient for development.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=aevo
SESSION_COOKIE_NAME=aevo_session
SESSION_TTL_HOURS=168
LOG_LEVEL=info
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
SEED_ORGANIZATION_NAME=Aevo Demo
SEED_STORE_NAME=Main Store
SEED_STORE_TIMEZONE=Asia/Bangkok
