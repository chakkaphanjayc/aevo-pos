NODE_ENV=development
# Local-only in-memory UI/API test mode. Never enable this in production.
AEVO_TEST_MODE=0
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:4332
AEVO_DEV_TUNNEL=0
# Optional stable public hostname. The root local launcher uses this value to
# update callback and CORS allowlists without copying secrets between apps.
# AEVO_POS_TUNNEL_URL=https://pos-dev.example.com
# Local development: modern frontend points to separately running API
PUBLIC_API_URL=http://localhost:3001
# Server-only Supabase key. Never expose this in apps/web or PUBLIC_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SESSION_COOKIE_NAME=aevo_pos_session
SESSION_COOKIE_SECRET=replace-with-a-long-random-secret
CSRF_COOKIE_NAME=aevo_pos_csrf
# Use "none" only when the web and API are on different sites; production must use HTTPS.
SESSION_COOKIE_SAME_SITE=lax
MODERN_WEB_ORIGIN=http://localhost:4332
AEVO_HUB_WEB_URL=http://localhost:4330
# Core/Accounts app-session broker.
AEVO_ACCOUNTS_API_URL=
AEVO_ACCOUNTS_EXCHANGE_SECRET=replace-with-the-accounts-service-secret
LOG_LEVEL=info
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
SEED_INITIAL_ROLE=OWNER
SEED_ORGANIZATION_NAME=Aevo Demo
SEED_STORE_NAME=Main Store
SEED_STORE_TIMEZONE=Asia/Bangkok
