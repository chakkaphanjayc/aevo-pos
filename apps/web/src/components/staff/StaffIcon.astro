---
type IconName =
  | "dashboard"
  | "catalog"
  | "pos"
  | "orders"
  | "queue"
  | "prep"
  | "settings"
  | "store"
  | "user"
  | "logout"
  | "menu"
  | "chevron-down"
  | "chevron-right"
  | "plus"
  | "search"
  | "filter"
  | "refresh"
  | "more"
  | "edit"
  | "archive"
  | "check"
  | "close"
  | "arrow-right"
  | "sliders"
  | "layers"
  | "tag"
  | "clock"
  | "spark"
  | "list"
  | "grid"
  | "receipt"
  | "utensils";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  class="staff-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "dashboard" && <>
    <rect x="3" y="3" width="7" height="7" rx="1.5" />
    <rect x="14" y="3" width="7" height="7" rx="1.5" />
    <rect x="3" y="14" width="7" height="7" rx="1.5" />
    <rect x="14" y="14" width="7" height="7" rx="1.5" />
  </>}
  {name === "catalog" && <>
    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z" />
    <path d="M4 5.5v16M8 7h8M8 11h8" />
  </>}
  {name === "pos" && <>
    <rect x="3" y="4" width="18" height="14" rx="2" />
    <path d="M7 21h10M9 18v3M15 18v3M7 8h10M7 12h3M14 12h3" />
  </>}
  {name === "orders" && <>
    <path d="M7 3h10a2 2 0 0 1 2 2v16l-3-2-4 2-4-2-3 2V5a2 2 0 0 1 2-2z" />
    <path d="M8 8h8M8 12h8M8 16h4" />
  </>}
  {name === "queue" && <>
    <path d="M5 4h14M5 12h14M5 20h14" />
    <circle cx="3" cy="4" r=".8" fill="currentColor" stroke="none" />
    <circle cx="3" cy="12" r=".8" fill="currentColor" stroke="none" />
    <circle cx="3" cy="20" r=".8" fill="currentColor" stroke="none" />
  </>}
  {name === "prep" && <>
    <path d="M4 5h16v14H4z" />
    <path d="m8 12 2.5 2.5L16 9" />
  </>}
  {name === "settings" && <>
    <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" />
    <circle cx="12" cy="12" r="4" />
  </>}
  {name === "store" && <>
    <path d="M4 10h16v10H4zM3 10l1.5-5h15L21 10" />
    <path d="M3 10a3 3 0 0 0 5 2 3 3 0 0 0 4 0 3 3 0 0 0 4 0 3 3 0 0 0 5-2M8 20v-5h8v5" />
  </>}
  {name === "user" && <>
    <circle cx="12" cy="8" r="3" />
    <path d="M5 21a7 7 0 0 1 14 0" />
  </>}
  {name === "logout" && <>
    <path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9" />
  </>}
  {name === "menu" && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6" />}
  {name === "chevron-right" && <path d="m9 6 6 6-6 6" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "search" && <><circle cx="10.8" cy="10.8" r="6.2" /><path d="m16 16 4.5 4.5" /></>}
  {name === "filter" && <path d="M4 6h16M7 12h10M10 18h4" />}
  {name === "refresh" && <><path d="M20 11a8 8 0 0 0-14.7-4L4 9" /><path d="M4 4v5h5M4 13a8 8 0 0 0 14.7 4L20 15" /><path d="M20 20v-5h-5" /></>}
  {name === "more" && <><circle cx="5" cy="12" r="1" fill="currentColor" stroke="none" /><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" /><circle cx="19" cy="12" r="1" fill="currentColor" stroke="none" /></>}
  {name === "edit" && <><path d="m4 16.5-.8 4.3 4.3-.8L19 8.5 15.5 5z" /><path d="m13.5 7 3.5 3.5" /></>}
  {name === "archive" && <><path d="M4 7h16v13H4zM3 4h18v3H3zM9 12h6" /></>}
  {name === "check" && <path d="m5 12 4 4L19 6" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
