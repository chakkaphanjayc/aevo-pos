---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StaffIcon from "./StaffIcon.astro";
import StaffPreviewModal from "./StaffPreviewModal.astro";
import type { Permission } from "@aevo/contracts";

type StaffSection = "hub" | "workspace" | "catalog" | "pos" | "orders" | "queue" | "prep" | "tables" | "booking" | "reports" | "users" | "devices" | "audit" | "settings" | "preview";

interface Props {
  title: string;
  active: StaffSection;
  fullHeight?: boolean;
}

const { title, active, fullHeight = false } = Astro.props;

const navItems = [
  { key: "hub", group: "Ecosystem", label: "Aevo Hub", helper: "Apps & Plans", icon: "hub", href: "/staff/hub", permission: "store.read" as Permission, ready: true },
  { key: "workspace", group: "Workspace", label: "ภาพรวม", helper: "Workspace", icon: "dashboard", href: "/staff/workspace", permission: "store.read" as Permission, ready: true },
  { key: "catalog", group: "Store", label: "สินค้า", helper: "Catalog", icon: "catalog", href: "/staff/catalog", permission: "catalog.read" as Permission, ready: true },
  { key: "pos", group: "Sales", label: "ขายหน้าร้าน", helper: "POS", icon: "pos", href: "/staff/pos", permission: "order.create" as Permission, ready: true },
  { key: "orders", group: "Sales", label: "ออเดอร์", helper: "Orders", icon: "orders", href: "/staff/orders", permission: "order.read" as Permission, ready: true },
  { key: "queue", group: "Sales", label: "คิวรับสินค้า", helper: "Queue", icon: "queue", href: "/staff/queue", permission: "store.read" as Permission, ready: true },
  { key: "prep", group: "Sales", label: "เตรียมสินค้า", helper: "Preparation", icon: "prep", href: "/staff/preparation", permission: "order.create" as Permission, ready: true },
  { key: "tables", group: "Store", label: "ผังโต๊ะ", helper: "Tables", icon: "utensils", href: "/staff/tables", permission: "store.read" as Permission, ready: true },
  { key: "booking", group: "Store", label: "การจอง", helper: "Booking", icon: "calendar", href: "/staff/booking", permission: "store.read" as Permission, ready: true },
  { key: "preview", group: "Store", label: "พรีวิวระบบ", helper: "Preview Modes", icon: "preview", href: "/staff/preview", permission: "store.read" as Permission, ready: true },
  { key: "reports", group: "Finance", label: "รายงาน", helper: "Reports", icon: "receipt", href: "/staff/reports", permission: "audit.read" as Permission, ready: true },
  { key: "users", group: "Settings", label: "ผู้ใช้งาน", helper: "Users & Roles", icon: "user", href: "/staff/users", permission: "member.manage" as Permission, ready: true },
  { key: "devices", group: "Settings", label: "อุปกรณ์", helper: "Devices", icon: "settings", href: "/staff/devices", permission: "devices.manage" as Permission, ready: true },
  { key: "audit", group: "Settings", label: "ประวัติการใช้งาน", helper: "Audit Log", icon: "receipt", href: "/staff/audit", permission: "audit.read" as Permission, ready: true },
  { key: "settings", group: "Settings", label: "ตั้งค่า", helper: "Settings", icon: "settings", href: "/staff/settings", permission: "store.manage" as Permission, ready: false }
] as const;

const primaryMobileItems = navItems.slice(0, 4);
---

<BaseLayout title={title}>
  <script is:inline>
    if (window.self !== window.top || new URLSearchParams(window.location.search).has("preview")) {
      document.documentElement.classList.add("is-preview-embedded");
    }
    if (localStorage.getItem("aevo.staff.sidebar_collapsed") === "true") {
      document.documentElement.classList.add("sidebar-collapsed");
    }
  </script>
  <div class:list={["staff-app", { "staff-app-full": fullHeight }]} data-staff-shell>
    <header class="staff-topbar">
      <button class="staff-sidebar-toggle" id="staff-sidebar-toggle" type="button" aria-label="ย่อ/ขยายเมนูด้านข้าง" title="ย่อ/ขยายเมนูด้านข้าง (Collapse Sidebar)">
        <StaffIcon name="menu" size={18} />
      </button>

      <button class="staff-menu-toggle" id="staff-menu-toggle" type="button" aria-label="เปิดเมนู" aria-expanded="false" aria-controls="staff-mobile-drawer">
        <StaffIcon name="menu" size={20} />
      </button>

      <a class="staff-brand" href="/staff" aria-label="Aevo Staff กลับหน้าเลือกสาขา">
        <span class="staff-logo-mark" aria-hidden="true"><span>A</span></span>
        <span class="staff-brand-copy"><strong>Aevo</strong><span>Staff</span></span>
      </a>

      <div class="staff-store-context">
        <div class="staff-store-copy">
          <span class="staff-context-label">สาขาที่ใช้งาน</span>
          <span class="staff-store-name" id="store-name" data-staff-store-name>เลือกสาขา</span>
          <span class="staff-store-code" data-staff-store-code>—</span>
        </div>
        <label class="staff-store-select">
          <span class="sr-only">เลือกสาขา</span>
          <select id="staff-store-select" aria-label="เลือกสาขา">
            <option value="">กำลังโหลด…</option>
          </select>
        </label>
      </div>

      <div class="staff-topbar-actions">
        <!-- Page-specific operational actions (Shift, Held Orders, etc.) -->
        <slot name="top-actions" />

        <div class="staff-topbar-divider" aria-hidden="true"></div>

        <!-- Global Utility Actions -->
        <button class="staff-preview-trigger-btn" data-action="open-preview" type="button" title="พรีวิวโหมดต่าง ๆ (ลูกค้า, Kiosk, TV, POS)">
          <StaffIcon name="preview" size={16} />
          <span>พรีวิวโหมด</span>
        </button>
        <span class="status staff-connection-status" id="connection-status" data-staff-connection>กำลังตรวจสอบ</span>
        <div class="staff-user" title="ผู้ใช้งานปัจจุบัน">
          <span class="staff-user-avatar" aria-hidden="true"><StaffIcon name="user" size={16} /></span>
          <span class="staff-user-copy"><strong data-staff-user-name>กำลังโหลด…</strong><span data-staff-user-role>Staff</span></span>
        </div>
        <button class="staff-logout" id="logout" type="button" aria-label="ออกจากระบบ" title="ออกจากระบบ">
          <StaffIcon name="logout" size={18} /><span>ออกจากระบบ</span>
        </button>
      </div>
    </header>

    <div class="staff-layout">
      <aside class="staff-sidebar" aria-label="เมนู Staff">
        <div class="staff-sidebar-section-label">เมนูหลัก</div>
        <nav class="staff-nav">
          {navItems.map((item, index) => (
            <Fragment>
              {(index === 0 || navItems[index - 1]?.group !== item.group) && <div class="staff-nav-group-label">{item.group}</div>}
              {item.ready ? (
                <a
                  class:list={["staff-nav-link", { "is-active": item.key === active }]}
                  href={item.href}
                  title={item.label}
                  data-staff-store-link="true"
                  data-staff-permission={item.permission}
                  data-staff-nav-link
                >
                  <span class="staff-nav-icon"><StaffIcon name={item.icon} size={18} /></span>
                  <span class="staff-nav-copy"><strong>{item.label}</strong><small>{item.helper}</small></span>
                </a>
              ) : (
                <span class="staff-nav-link is-disabled" data-staff-permission={item.permission} aria-disabled="true" title="ฟีเจอร์นี้กำลังพัฒนา">
                  <span class="staff-nav-icon"><StaffIcon name={item.icon} size={18} /></span>
                  <span class="staff-nav-copy"><strong>{item.label}</strong><small>{item.helper}</small></span>
                  <span class="staff-nav-status">เร็ว ๆ นี้</span>
                </span>
              )}
            </Fragment>
          ))}
        </nav>
        <div class="staff-sidebar-footer">
          <div class="staff-tenant-context">
            <span class="staff-context-label">องค์กร</span>
            <strong data-staff-tenant>ตรวจสอบสิทธิ์แล้ว</strong>
          </div>
          <a class="staff-change-store" href="/staff"><StaffIcon name="store" size={16} />เปลี่ยนสาขา</a>
        </div>
      </aside>

      <main class:list={["staff-main", { "staff-main-full": fullHeight }]}>
        <slot />
      </main>
    </div>

    <div class="staff-scrim" id="staff-scrim" hidden></div>
    <aside class="staff-mobile-drawer" id="staff-mobile-drawer" aria-label="เมนู Staff" aria-hidden="true">
      <div class="staff-mobile-drawer-header">
        <span class="staff-context-label">เมนูการทำงาน</span>
        <button class="staff-icon-button" id="staff-mobile-close" type="button" aria-label="ปิดเมนู"><StaffIcon name="close" size={18} /></button>
      </div>
      <nav class="staff-mobile-drawer-nav">
        {navItems.map((item) => (
          item.ready ? (
            <a
              class:list={["staff-nav-link", { "is-active": item.key === active }]}
              href={item.href}
              data-staff-store-link="true"
              data-staff-permission={item.permission}
              data-staff-nav-link
            >
              <span class="staff-nav-icon"><StaffIcon name={item.icon} size={18} /></span>
              <span class="staff-nav-copy"><strong>{item.label}</strong><small>{item.helper}</small></span>
            </a>
          ) : (
              <span class="staff-nav-link is-disabled" data-staff-permission={item.permission} aria-disabled="true">
              <span class="staff-nav-icon"><StaffIcon name={item.icon} size={18} /></span>
              <span class="staff-nav-copy"><strong>{item.label}</strong><small>{item.helper}</small></span>
              <span class="staff-nav-status">กำลังพัฒนา</span>
            </span>
          )
        ))}
      </nav>
    </aside>

    <nav class="staff-bottom-nav" aria-label="ทางลัด Staff">
      {primaryMobileItems.map((item) => (
        <a
          class:list={["staff-bottom-nav-link", { "is-active": item.key === active }]}
          href={item.href}
          data-staff-store-link="true"
          data-staff-permission={item.permission}
          data-staff-nav-link
        >
          <StaffIcon name={item.icon} size={18} />
          <span>{item.label}</span>
        </a>
      ))}
      <button class="staff-bottom-nav-link" id="staff-bottom-more" type="button" aria-label="เมนูเพิ่มเติม">
        <StaffIcon name="menu" size={18} />
        <span>เพิ่มเติม</span>
      </button>
    </nav>
    <StaffPreviewModal />
  </div>

  <script>
    const sidebarToggle = document.getElementById("staff-sidebar-toggle");
    if (sidebarToggle) {
      sidebarToggle.addEventListener("click", () => {
        const isCollapsed = document.documentElement.classList.toggle("sidebar-collapsed");
        localStorage.setItem("aevo.staff.sidebar_collapsed", isCollapsed ? "true" : "false");
      });
    }
  </script>
</BaseLayout>
