---
import BaseLayout from "../../layouts/BaseLayout.astro";

const { store: storeCode = "" } = Astro.params as { store?: string };

// The Worker currently deploys the web app as static assets. Store codes are
// tenant data and cannot be enumerated safely at build time, so this route is
// intentionally left to the runtime/dev router until a server adapter is used.
export function getStaticPaths() {
  // Store codes are tenant data and cannot be enumerated at build time. The
  // Worker rewrites /order/:store to this runtime shell asset.
  return [{ params: { store: "__runtime__" } }];
}
---
<BaseLayout title="สั่งอาหารออนไลน์">
  <div class="qr-app" id="qr-app" data-store-code={storeCode || ""}>
    <!-- Store Header -->
    <header class="qr-header">
      <div class="qr-header-info">
        <span class="qr-brand-tag">AEVO SELF-ORDER</span>
        <h1 class="qr-store-name" id="store-title">กำลังโหลดร้านค้า…</h1>
        <div class="qr-meta-row">
          <span class="qr-table-pill" id="table-badge" hidden>📍 โต๊ะ <strong id="table-number-text"></strong></span>
          <span class="status online" id="store-status">เปิดรับออเดอร์</span>
        </div>
      </div>
    </header>

    <!-- Category Tabs -->
    <nav class="qr-categories-wrap" aria-label="หมวดหมู่อาหาร">
      <div class="qr-categories" id="category-tabs">
        <button class="qr-cat-pill active" data-category="all" type="button">ทั้งหมด</button>
      </div>
    </nav>

    <!-- Product Grid -->
    <main class="qr-main">
      <div class="qr-loading" id="loading-state">
        <div class="qr-spinner"></div>
        <p>กำลังเตรียมเมนูแสนอร่อย…</p>
      </div>

      <div class="qr-error-state" id="error-state" hidden>
        <span class="qr-error-icon">🏬</span>
        <h2>ไม่พบร้านค้า</h2>
        <p id="error-message">ร้านค้านี้อาจยังไม่เปิดบริการ หรือรหัสร้านไม่ถูกต้อง</p>
      </div>

      <div class="qr-product-grid" id="product-grid" hidden></div>
    </main>

    <!-- Bottom floating cart bar -->
    <div class="qr-cart-bar" id="cart-bar" hidden>
      <div class="qr-cart-bar-details">
        <span class="qr-cart-count-badge" id="cart-item-count">0</span>
        <div class="qr-cart-bar-total">
          <small>ยอดรวม</small>
          <strong id="cart-bar-total-text">฿0.00</strong>
        </div>
      </div>
      <button class="qr-btn qr-btn-primary qr-view-cart-btn" id="open-cart-btn" type="button">
        ดูตะกร้า 🛒
      </button>
    </div>

    <!-- Modifier Selection Dialog -->
    <dialog class="qr-modal" id="mod-modal">
      <div class="qr-modal-content">
        <header class="qr-modal-header">
          <div>
            <h3 id="mod-product-title">ตัวเลือกสินค้า</h3>
            <p class="qr-modal-subtitle" id="mod-product-desc"></p>
          </div>
          <button class="qr-close-btn" id="mod-close-btn" type="button" aria-label="ปิด">✕</button>
        </header>

        <div class="qr-modal-body" id="mod-groups-container"></div>

        <footer class="qr-modal-footer">
          <div class="qr-mod-total-display">
            <small>ราคารวม</small>
            <strong id="mod-price-display">฿0.00</strong>
          </div>
          <button class="qr-btn qr-btn-primary" id="mod-add-btn" type="button">เพิ่มลงตะกร้า</button>
        </footer>
      </div>
    </dialog>

    <!-- Cart Bottom Sheet / Drawer -->
    <dialog class="qr-modal qr-cart-modal" id="cart-modal">
      <div class="qr-modal-content qr-cart-content">
        <header class="qr-modal-header">
          <h3>ตะกร้าสินค้า</h3>
          <button class="qr-close-btn" id="cart-close-btn" type="button" aria-label="ปิด">✕</button>
        </header>

        <div class="qr-modal-body qr-cart-body">
          <!-- Items -->
          <div class="qr-cart-items-list" id="cart-items-container">
            <p class="qr-empty-cart">ยังไม่มีสินค้าในตะกร้า</p>
          </div>

          <!-- Checkout Details -->
          <div class="qr-checkout-details" id="checkout-details">
            <div class="qr-form-group">
              <label for="qr-fulfillment">ประเภทการรับสินค้า</label>
              <div class="qr-segmented-control" id="qr-fulfillment">
                <button class="qr-segment active" data-type="DINE_IN" type="button" id="seg-dinein">ทานที่ร้าน</button>
                <button class="qr-segment" data-type="TAKEAWAY" type="button" id="seg-takeaway">ซื้อกลับ</button>
              </div>
            </div>

            <div class="qr-form-row">
              <div class="qr-form-group" id="table-group">
                <label for="input-table">หมายเลขโต๊ะ</label>
                <input class="qr-input" type="text" id="input-table" placeholder="เช่น 5 หรือ A1" maxlength="32" />
              </div>
              <div class="qr-form-group">
                <label for="input-customer">ชื่อลูกค้า (ไม่จำเป็น)</label>
                <input class="qr-input" type="text" id="input-customer" placeholder="ชื่อเล่นของคุณ" maxlength="160" />
              </div>
            </div>

            <div class="qr-form-group">
              <label for="input-phone">เบอร์โทรติดต่อ (ไม่จำเป็น)</label>
              <input class="qr-input" type="tel" id="input-phone" placeholder="08x-xxx-xxxx" maxlength="40" />
            </div>

            <div class="qr-form-group">
              <label for="input-notes">ข้อความถึงร้าน / หมายเหตุ</label>
              <textarea class="qr-input qr-textarea" id="input-notes" rows="2" placeholder="เช่น ไม่ใส่ผักชี, แยกน้ำแข็ง" maxlength="500"></textarea>
            </div>

            <!-- Order Summary Lines -->
            <div class="qr-bill-summary">
              <div class="qr-bill-row"><span>ยอดรวมสินค้า</span><span id="bill-subtotal">฿0.00</span></div>
              <div class="qr-bill-row qr-bill-grand"><span>ยอดสุทธิ</span><strong id="bill-total">฿0.00</strong></div>
            </div>
          </div>
        </div>

        <footer class="qr-modal-footer qr-cart-footer">
          <button class="qr-btn qr-btn-primary qr-submit-order-btn" id="submit-order-btn" type="button">
            ยืนยันการสั่งอาหาร
          </button>
        </footer>
      </div>
    </dialog>

    <!-- Success Confirmation Modal -->
    <dialog class="qr-modal" id="success-modal">
      <div class="qr-modal-content qr-success-content">
        <div class="qr-success-icon">🎉</div>
        <h2>สั่งอาหารสำเร็จแล้ว!</h2>
        <p class="qr-success-message">ออเดอร์ของคุณถูกส่งไปยังครัวเรียบร้อยแล้ว</p>

        <div class="qr-order-card">
          <div class="qr-order-num-label">หมายเลขคำสั่งซื้อ</div>
          <div class="qr-order-number" id="success-order-num">-</div>
          <div class="qr-order-meta" id="success-order-meta"></div>
        </div>

        <p class="qr-success-hint">กรุณารอรับอาหารตามคิว หรือติดต่อเคาน์เตอร์แคชเชียร์</p>
        <a class="qr-btn qr-btn-secondary qr-track-link" id="success-track-link" href="#" hidden>ติดตามออเดอร์</a>
        <button class="qr-btn qr-btn-primary qr-done-btn" id="success-done-btn" type="button">
          สั่งอาหารเพิ่ม
        </button>
      </div>
    </dialog>
  </div>

  <script>
    import { api, apiWithIdempotency, ApiError } from "../../lib/api";
    import type {
      PublicCatalogSnapshot,
      PublicProductItem,
      CreatePublicOrderInput,
      OrderSummary
    } from "@aevo/contracts";
    import {
      createEmptyQrCart,
      addQrItem,
      updateQrQuantity,
      clearQrCart,
      calculateQrTotals,
      formatMoney,
      saveCustomerInfo,
      type QrCartItemModifier
    } from "../../lib/qr-cart";

    const appEl = document.getElementById("qr-app")!;
    const configuredStoreCode = appEl.dataset.storeCode || "";
    // Parse optional query parameters (?table=... / ?store=...)
    const queryParams = new URLSearchParams(window.location.search);
    let storeCode = configuredStoreCode !== "__runtime__" && configuredStoreCode !== ""
      ? configuredStoreCode
      : decodeURIComponent(window.location.pathname.split("/")[2] || "");
    if (storeCode === "__runtime__" || !storeCode) {
      storeCode = queryParams.get("store") || queryParams.get("storeCode") || "";
    }
    const initialTable = queryParams.get("table") || "";

    let catalog: PublicCatalogSnapshot | null = null;
    let cart = createEmptyQrCart(storeCode, initialTable || undefined);
    let selectedCategoryId = "all";

    // Modals
    const modModal = document.getElementById("mod-modal") as HTMLDialogElement;
    const cartModal = document.getElementById("cart-modal") as HTMLDialogElement;
    const successModal = document.getElementById("success-modal") as HTMLDialogElement;

    // Active product for modifier selection
    let currentModalProduct: PublicProductItem | null = null;
    let currentModalVariantId: string | undefined;

    /* ---------------------------------------------------------------- */
    /* Init & Load Catalog                                              */
    /* ---------------------------------------------------------------- */
    async function loadPublicMenu() {
      const loadingEl = document.getElementById("loading-state")!;
      const errorEl = document.getElementById("error-state")!;
      const gridEl = document.getElementById("product-grid")!;

      if (!storeCode) {
        loadingEl.hidden = true;
        errorEl.hidden = false;
        return;
      }

      try {
        catalog = await api<PublicCatalogSnapshot>(`/api/public/catalog?storeCode=${encodeURIComponent(storeCode)}&channel=QR`);
        loadingEl.hidden = true;
        gridEl.hidden = false;

        document.getElementById("store-title")!.textContent = catalog.store.name;

        if (initialTable) {
          const tableBadge = document.getElementById("table-badge")!;
          document.getElementById("table-number-text")!.textContent = initialTable;
          tableBadge.hidden = false;
          (document.getElementById("input-table") as HTMLInputElement).value = initialTable;
        }

        renderCategories();
        renderProducts();
      } catch (cause) {
        loadingEl.hidden = true;
        errorEl.hidden = false;
        const msg = cause instanceof ApiError ? cause.message : "ไม่สามารถเชื่อมต่อร้านค้าได้";
        document.getElementById("error-message")!.textContent = msg;
      }
    }

    /* ---------------------------------------------------------------- */
    /* Render Categories                                                */
    /* ---------------------------------------------------------------- */
    function renderCategories() {
      if (!catalog) return;
      const tabsContainer = document.getElementById("category-tabs")!;
      tabsContainer.innerHTML = "";

      const allBtn = document.createElement("button");
      allBtn.className = "qr-cat-pill active";
      allBtn.dataset.cat = "all";
      allBtn.type = "button";
      allBtn.textContent = "ทั้งหมด";
      allBtn.addEventListener("click", () => filterCategory("all"));
      tabsContainer.appendChild(allBtn);

      for (const cat of catalog.categories) {
        const btn = document.createElement("button");
        btn.className = "qr-cat-pill";
        btn.dataset.cat = cat.id;
        btn.type = "button";
        btn.textContent = cat.name;
        btn.addEventListener("click", () => filterCategory(cat.id));
        tabsContainer.appendChild(btn);
      }
    }

    function filterCategory(catId: string) {
      selectedCategoryId = catId;
      document.querySelectorAll(".qr-cat-pill").forEach((pill) => {
        pill.classList.toggle("active", (pill as HTMLElement).dataset.cat === catId);
      });
      renderProducts();
    }

    /* ---------------------------------------------------------------- */
    /* Render Products                                                  */
    /* ---------------------------------------------------------------- */
    function renderProducts() {
      if (!catalog) return;
      const grid = document.getElementById("product-grid")!;
      grid.innerHTML = "";

      const filtered = selectedCategoryId === "all"
        ? catalog.products
        : catalog.products.filter((p) => p.categoryId === selectedCategoryId);

      if (filtered.length === 0) {
        grid.innerHTML = '<div class="qr-no-products">ไม่มีสินค้าในหมวดหมู่นี้</div>';
        return;
      }

      for (const product of filtered) {
        const card = document.createElement("article");
        card.className = `qr-card${product.soldOut ? " sold-out" : ""}`;

        const priceText = formatMoney(product.effectivePriceMinor, product.currency);
        const hasCustomization = product.variants.length > 0 || product.modifierGroups.length > 0;

        card.innerHTML = `
          <div class="qr-card-body">
            <h4 class="qr-card-name"></h4>
            <p class="qr-card-desc"></p>
            <div class="qr-card-price-row">
              <span class="qr-card-price"></span>
              <button class="qr-card-add-btn" type="button" ${product.soldOut ? "disabled" : ""}>
                ${product.soldOut ? "หมด" : hasCustomization ? "เลือก" : "+ เพิ่ม"}
              </button>
            </div>
          </div>
        `;

        card.querySelector(".qr-card-name")!.textContent = product.name;
        card.querySelector(".qr-card-desc")!.textContent = product.description || "";
        card.querySelector(".qr-card-price")!.textContent = priceText;

        const addBtn = card.querySelector<HTMLButtonElement>(".qr-card-add-btn")!;
        addBtn.addEventListener("click", () => {
          if (product.soldOut) return;
          if (hasCustomization) {
            openModifierModal(product);
          } else {
            cart = addQrItem(cart, {
              productId: product.id,
              productName: product.name,
              unitPriceMinor: product.effectivePriceMinor,
              quantity: 1,
              modifiers: []
            });
            updateCartUi();
          }
        });

        grid.appendChild(card);
      }
    }

    /* ---------------------------------------------------------------- */
    /* Modifier / Option Modal                                          */
    /* ---------------------------------------------------------------- */
    function openModifierModal(product: PublicProductItem) {
      currentModalProduct = product;
      currentModalVariantId = product.variants[0]?.id;

      document.getElementById("mod-product-title")!.textContent = product.name;
      document.getElementById("mod-product-desc")!.textContent = product.description || "";

      const container = document.getElementById("mod-groups-container")!;
      container.innerHTML = "";

      // Variants
      if (product.variants.length > 0) {
        const varGroup = document.createElement("div");
        varGroup.className = "qr-mod-group";
        varGroup.innerHTML = `
          <div class="qr-mod-group-title">
            <strong>ขนาด / รูปแบบ</strong>
            <span class="qr-mod-req">จำเป็น</span>
          </div>
          <div class="qr-mod-options"></div>
        `;
        const optsContainer = varGroup.querySelector(".qr-mod-options")!;
        product.variants.forEach((v, idx) => {
          const opt = document.createElement("label");
          opt.className = "qr-mod-opt";
          opt.innerHTML = `
            <input type="radio" name="variant_opt" value="${v.id}" ${idx === 0 ? "checked" : ""} />
            <span>${v.name}</span>
            <span class="qr-opt-delta">${formatMoney(v.priceMinor)}</span>
          `;
          opt.querySelector("input")!.addEventListener("change", () => {
            currentModalVariantId = v.id;
            updateModalPrice();
          });
          optsContainer.appendChild(opt);
        });
        container.appendChild(varGroup);
      }

      // Modifier Groups
      for (const group of product.modifierGroups) {
        const grpEl = document.createElement("div");
        grpEl.className = "qr-mod-group";
        grpEl.dataset.groupId = group.id;
        grpEl.dataset.required = String(group.required);
        grpEl.dataset.min = String(group.minSelections);
        grpEl.dataset.max = String(group.maxSelections);
        grpEl.dataset.type = group.selectionType;

        const reqText = group.required ? "จำเป็น" : "ไม่จำเป็น";
        grpEl.innerHTML = `
          <div class="qr-mod-group-title">
            <strong>${group.name}</strong>
            <span class="qr-mod-req">${reqText}</span>
          </div>
          <div class="qr-mod-options"></div>
        `;

        const optsContainer = grpEl.querySelector(".qr-mod-options")!;
        for (const mod of group.modifiers) {
          const opt = document.createElement("label");
          opt.className = "qr-mod-opt";
          const inputType = group.selectionType === "SINGLE" ? "radio" : "checkbox";
          const deltaText = mod.priceDeltaMinor > 0 ? `+${formatMoney(mod.priceDeltaMinor)}` : "ฟรี";

          opt.innerHTML = `
            <input type="${inputType}" name="mod_group_${group.id}" value="${mod.id}" data-delta="${mod.priceDeltaMinor}" data-name="${mod.name}" />
            <span>${mod.name}</span>
            <span class="qr-opt-delta">${deltaText}</span>
          `;

          opt.querySelector("input")!.addEventListener("change", () => {
            updateModalPrice();
          });
          optsContainer.appendChild(opt);
        }
        container.appendChild(grpEl);
      }

      updateModalPrice();
      modModal.showModal();
    }

    function updateModalPrice() {
      if (!currentModalProduct) return;
      let unitPrice = currentModalProduct.effectivePriceMinor;

      if (currentModalVariantId && currentModalProduct.variants.length > 0) {
        const selectedVar = currentModalProduct.variants.find((v) => v.id === currentModalVariantId);
        if (selectedVar) unitPrice = selectedVar.priceMinor;
      }

      const checkedModifiers = document.querySelectorAll<HTMLInputElement>("#mod-groups-container input:checked");
      let modTotal = 0;
      checkedModifiers.forEach((inp) => {
        if (inp.name !== "variant_opt") {
          modTotal += Number(inp.dataset.delta || 0);
        }
      });

      document.getElementById("mod-price-display")!.textContent = formatMoney(unitPrice + modTotal);

      // Validate required groups
      let isValid = true;
      const groups = document.querySelectorAll<HTMLElement>(".qr-mod-group[data-group-id]");
      groups.forEach((grp) => {
        const required = grp.dataset.required === "true";
        const min = Number(grp.dataset.min || 0);
        const count = grp.querySelectorAll("input:checked").length;
        if (required && count < Math.max(1, min)) {
          isValid = false;
        }
      });

      (document.getElementById("mod-add-btn") as HTMLButtonElement).disabled = !isValid;
    }

    document.getElementById("mod-close-btn")!.addEventListener("click", () => modModal.close());

    document.getElementById("mod-add-btn")!.addEventListener("click", () => {
      if (!currentModalProduct) return;

      let unitPrice = currentModalProduct.effectivePriceMinor;
      let variantName: string | undefined;

      if (currentModalVariantId && currentModalProduct.variants.length > 0) {
        const selectedVar = currentModalProduct.variants.find((v) => v.id === currentModalVariantId);
        if (selectedVar) {
          unitPrice = selectedVar.priceMinor;
          variantName = selectedVar.name;
        }
      }

      const checkedMods: QrCartItemModifier[] = [];
      document.querySelectorAll<HTMLInputElement>("#mod-groups-container input:checked").forEach((inp) => {
        if (inp.name !== "variant_opt") {
          checkedMods.push({
            modifierId: inp.value,
            name: inp.dataset.name || "",
            priceDeltaMinor: Number(inp.dataset.delta || 0)
          });
        }
      });

      cart = addQrItem(cart, {
        productId: currentModalProduct.id,
        productName: currentModalProduct.name,
        variantId: currentModalVariantId,
        variantName,
        unitPriceMinor: unitPrice,
        quantity: 1,
        modifiers: checkedMods
      });

      modModal.close();
      updateCartUi();
    });

    /* ---------------------------------------------------------------- */
    /* Cart UI & Bottom Bar                                             */
    /* ---------------------------------------------------------------- */
    function updateCartUi() {
      const cartBar = document.getElementById("cart-bar")!;
      const totalCount = cart.items.reduce((s, i) => s + i.quantity, 0);

      if (totalCount > 0) {
        const totals = calculateQrTotals(cart);
        document.getElementById("cart-item-count")!.textContent = String(totalCount);
        document.getElementById("cart-bar-total-text")!.textContent = formatMoney(totals.totalMinor);
        cartBar.hidden = false;
      } else {
        cartBar.hidden = true;
      }

      renderCartDrawer();
    }

    function renderCartDrawer() {
      const container = document.getElementById("cart-items-container")!;
      if (cart.items.length === 0) {
        container.innerHTML = '<p class="qr-empty-cart">ยังไม่มีสินค้าในตะกร้า</p>';
        document.getElementById("bill-subtotal")!.textContent = "฿0.00";
        document.getElementById("bill-total")!.textContent = "฿0.00";
        (document.getElementById("submit-order-btn") as HTMLButtonElement).disabled = true;
        return;
      }

      container.innerHTML = "";
      for (const item of cart.items) {
        const row = document.createElement("div");
        row.className = "qr-cart-row";

        const varLabel = item.variantName ? ` (${item.variantName})` : "";
        const modsList = item.modifiers.map((m) => `<small class="qr-cart-item-mod">+ ${m.name}</small>`).join("");
        const total = (item.unitPriceMinor + item.modifierPriceMinor) * item.quantity;

        row.innerHTML = `
          <div class="qr-cart-item-info">
            <strong>${item.productName}${varLabel}</strong>
            ${modsList}
            <span class="qr-cart-item-price">${formatMoney(total)}</span>
          </div>
          <div class="qr-cart-qty-ctrl">
            <button class="qr-qty-btn dec" type="button">-</button>
            <span class="qr-qty-val">${item.quantity}</span>
            <button class="qr-qty-btn inc" type="button">+</button>
          </div>
        `;

        row.querySelector(".dec")!.addEventListener("click", () => {
          cart = updateQrQuantity(cart, item.id, item.quantity - 1);
          updateCartUi();
        });
        row.querySelector(".inc")!.addEventListener("click", () => {
          cart = updateQrQuantity(cart, item.id, item.quantity + 1);
          updateCartUi();
        });

        container.appendChild(row);
      }

      const totals = calculateQrTotals(cart);
      document.getElementById("bill-subtotal")!.textContent = formatMoney(totals.subtotalMinor);
      document.getElementById("bill-total")!.textContent = formatMoney(totals.totalMinor);
      (document.getElementById("submit-order-btn") as HTMLButtonElement).disabled = false;
    }

    document.getElementById("open-cart-btn")!.addEventListener("click", () => {
      cartModal.showModal();
    });
    document.getElementById("cart-close-btn")!.addEventListener("click", () => {
      cartModal.close();
    });

    // Fulfillment segment buttons
    document.getElementById("seg-dinein")!.addEventListener("click", () => {
      cart.fulfillmentType = "DINE_IN";
      document.getElementById("seg-dinein")!.classList.add("active");
      document.getElementById("seg-takeaway")!.classList.remove("active");
      document.getElementById("table-group")!.hidden = false;
    });
    document.getElementById("seg-takeaway")!.addEventListener("click", () => {
      cart.fulfillmentType = "TAKEAWAY";
      document.getElementById("seg-takeaway")!.classList.add("active");
      document.getElementById("seg-dinein")!.classList.remove("active");
      document.getElementById("table-group")!.hidden = true;
    });

    /* ---------------------------------------------------------------- */
    /* Submit Order                                                     */
    /* ---------------------------------------------------------------- */
    const submitBtn = document.getElementById("submit-order-btn") as HTMLButtonElement;
    submitBtn.addEventListener("click", async () => {
      if (cart.items.length === 0) return;

      const customerName = (document.getElementById("input-customer") as HTMLInputElement).value.trim();
      const customerPhone = (document.getElementById("input-phone") as HTMLInputElement).value.trim();
      const tableNumber = (document.getElementById("input-table") as HTMLInputElement).value.trim();
      const notes = (document.getElementById("input-notes") as HTMLTextAreaElement).value.trim();

      saveCustomerInfo(customerName, customerPhone);

      submitBtn.disabled = true;
      submitBtn.textContent = "กำลังส่งออเดอร์…";

      const orderInput: CreatePublicOrderInput = {
        storeCode,
        channel: "QR",
        fulfillmentType: cart.fulfillmentType,
        ...(tableNumber ? { tableNumber } : {}),
        ...(customerName ? { customerName } : {}),
        ...(customerPhone ? { customerPhone } : {}),
        ...(notes ? { notes } : {}),
        items: cart.items.map((i) => ({
          productId: i.productId,
          ...(i.variantId ? { variantId: i.variantId } : {}),
          ...(i.modifiers.length > 0 ? { modifierIds: i.modifiers.map((m) => m.modifierId) } : {}),
          quantity: i.quantity,
          ...(i.note ? { note: i.note } : {})
        }))
      };

      try {
        const { order } = await apiWithIdempotency<{ order: OrderSummary }>(
          "/api/public/orders",
          "POST",
          orderInput
        );

        cartModal.close();
        cart = clearQrCart(cart);
        updateCartUi();

        // Show Success confirmation
        document.getElementById("success-order-num")!.textContent = order.orderNumber;
        const metaText = `ร้าน ${catalog?.store.name ?? ""} · ${order.fulfillmentType === "DINE_IN" ? (tableNumber ? `โต๊ะ ${tableNumber}` : "ทานที่ร้าน") : "ซื้อกลับ"}`;
        document.getElementById("success-order-meta")!.textContent = metaText;
        const trackingLink = document.getElementById("success-track-link") as HTMLAnchorElement;
        if (order.publicTrackingToken) {
          trackingLink.href = `/order/${encodeURIComponent(storeCode)}/track/${encodeURIComponent(order.publicTrackingToken)}`;
          trackingLink.hidden = false;
        }

        successModal.showModal();
      } catch (cause) {
        alert(cause instanceof Error ? cause.message : "ส่งออเดอร์ไม่สำเร็จ กรุณาลองใหม่อีกครั้ง");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "ยืนยันการสั่งอาหาร";
      }
    });

    document.getElementById("success-done-btn")!.addEventListener("click", () => {
      successModal.close();
    });

    loadPublicMenu();
  </script>

