---
export function getStaticPaths() {
  return [] as { params: { store: string; table: string } }[];
}

return Astro.redirect(`/order/${encodeURIComponent((Astro.params as { store?: string; table?: string }).store ?? "")}?table=${encodeURIComponent((Astro.params as { store?: string; table?: string }).table ?? "")}`);
---
