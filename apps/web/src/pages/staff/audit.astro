---
import StaffIcon from "../../components/staff/StaffIcon.astro";
import StaffShell from "../../components/staff/StaffShell.astro";
---

<StaffShell title="ประวัติการใช้งาน" active="audit">
  <div class="staff-page audit-page">
    <div class="staff-page-header">
      <div class="staff-page-heading"><p class="staff-eyebrow">Settings · Governance</p><h1 class="staff-page-title">ประวัติการใช้งาน</h1><p class="staff-page-lede">ตรวจสอบการเปลี่ยนแปลงสำคัญภายในองค์กรและสาขา</p></div>
      <button class="button secondary" id="refresh-audit" type="button"><StaffIcon name="refresh" size={16} />รีเฟรช</button>
    </div>
    <p class="error" id="audit-error" role="alert" hidden></p>
    <section class="audit-list surface">
      <div class="audit-list-heading"><div><span class="staff-eyebrow">Organization activity</span><h2>รายการล่าสุด</h2></div><span id="audit-count" class="audit-count">— รายการ</span></div>
      <div id="audit-grid" class="audit-grid"><div class="audit-empty">กำลังโหลดประวัติ…</div></div>
    </section>
  </div>

  <style is:global>
    .audit-page { display: flex; flex-direction: column; gap: 1.25rem; padding: 1.5rem; max-width: 1200px; margin: 0 auto; }
    .audit-list { padding: 18px; }
    .audit-list-heading { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; }
    .audit-list-heading h2 { margin: 4px 0 0; font-size: 1.15rem; }
    .audit-count, .audit-meta { color: var(--muted); font-size: .8rem; }
    .audit-grid { display: grid; gap: 8px; }
    .audit-row { display: grid; grid-template-columns: minmax(150px, .8fr) minmax(160px, 1fr) minmax(180px, 1.5fr) auto; gap: 16px; align-items: center; padding: 13px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface-soft); }
    .audit-action { color: var(--ink); font-weight: 800; font-size: .86rem; }
    .audit-resource { color: var(--brand); font-size: .8rem; font-weight: 700; }
    .audit-detail { color: var(--muted); font-size: .76rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .audit-empty { padding: 36px 12px; text-align: center; color: var(--muted); }
    @media (max-width: 760px) { .audit-page { padding: 1rem; } .audit-row { grid-template-columns: 1fr 1fr; gap: 8px; } .audit-meta { grid-column: 1 / -1; } }
  </style>

  <script>
    import type { AuditLogSummary, StoreSummary } from "@aevo/contracts";
    import { api } from "../../lib/api";
    import { friendlyErrorMessage, findSelectedStore, getSelectedStoreId, initStaffShell, loadStaffContext, storeUrl } from "../../lib/staff-ui";

    const grid = document.querySelector<HTMLElement>("#audit-grid")!;
    const error = document.querySelector<HTMLElement>("#audit-error")!;
    const count = document.querySelector<HTMLElement>("#audit-count")!;
    let stores: StoreSummary[] = [];

    function escapeHtml(value: string): string { const element = document.createElement("span"); element.textContent = value; return element.innerHTML; }
    function render(logs: AuditLogSummary[]): void {
      count.textContent = `${logs.length} รายการ`;
      grid.innerHTML = logs.length ? logs.map((log) => `<article class="audit-row"><div><div class="audit-action">${escapeHtml(log.action)}</div><div class="audit-meta">${new Date(log.createdAt).toLocaleString("th-TH")}</div></div><div class="audit-resource">${escapeHtml(log.resourceType)}${log.resourceId ? ` · ${escapeHtml(log.resourceId.slice(0, 8))}` : ""}</div><div class="audit-detail">${escapeHtml(JSON.stringify(log.metadata))}</div><div class="audit-meta">${escapeHtml(log.userId ? `ผู้ใช้ ${log.userId.slice(0, 8)}` : "ระบบ")}</div></article>`).join("") : '<div class="audit-empty">ยังไม่มีประวัติการใช้งาน</div>';
    }
    async function load(): Promise<void> {
      error.hidden = true;
      try { const result = await api<{ logs: AuditLogSummary[] }>("/api/audit-logs?limit=100"); render(result.logs); }
      catch (cause) { error.textContent = friendlyErrorMessage(cause, "โหลดประวัติไม่สำเร็จ"); error.hidden = false; grid.innerHTML = '<div class="audit-empty">ไม่สามารถโหลดประวัติได้ กรุณาลองใหม่</div>'; }
    }
    document.querySelector<HTMLButtonElement>("#refresh-audit")!.addEventListener("click", () => void load());
    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible") void load(); });
    window.setInterval(() => { if (document.visibilityState === "visible") void load(); }, 30_000);
    async function init(): Promise<void> {
      const context = await loadStaffContext(); stores = context.stores;
      const selected = findSelectedStore(stores, getSelectedStoreId());
      if (!selected) { window.location.assign("/staff"); return; }
      initStaffShell({ user: context.user, stores, selectedStoreId: selected.id, onStoreChange: async (storeId) => { history.replaceState(null, "", storeUrl("/staff/audit", storeId)); await load(); } });
      await load();
    }
    void init().catch((cause) => { error.textContent = friendlyErrorMessage(cause, "ไม่สามารถโหลดหน้าประวัติได้"); error.hidden = false; });
  </script>
</StaffShell>
