---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Workspace">
  <div class="shell">
    <header class="topbar">
      <a class="brand brand-link" href="/staff"><span class="brand-mark">A</span> Aevo Staff</a>
      <div class="header-actions"><span class="status">Online</span><button id="logout" class="button secondary" type="button">ออกจากระบบ</button></div>
    </header>
    <main class="page">
      <a class="back" href="/staff">← เปลี่ยนสาขา</a>
      <p class="eyebrow">Workspace foundation</p>
      <h1 id="welcome">กำลังโหลดข้อมูล…</h1>
      <p class="lede" id="store-summary">กำลังตรวจสอบสิทธิ์และบริบทสาขา</p>
      <p class="error" id="error" role="alert" hidden></p>
      <section class="workspace-grid" aria-label="Workspaces">
        <a class="card workspace-card workspace-link" id="catalog-link" href="#"><span class="workspace-icon">▤</span><h2>Catalog</h2><p>จัดการสินค้า หมวดหมู่ และ Sold out</p><span class="coming-soon ready">Phase 1</span></a>
        <article class="card workspace-card"><span class="workspace-icon">▦</span><h2>POS</h2><p>รับออเดอร์และรับชำระเงิน</p><span class="coming-soon">Phase 3</span></article>
        <article class="card workspace-card"><span class="workspace-icon">◫</span><h2>Orders</h2><p>ดูรายการและสถานะออเดอร์</p><span class="coming-soon">กำลังพัฒนา</span></article>
        <article class="card workspace-card"><span class="workspace-icon">✦</span><h2>Preparation</h2><p>จัดการงานเตรียมสินค้า</p><span class="coming-soon">กำลังพัฒนา</span></article>
        <article class="card workspace-card"><span class="workspace-icon">⌁</span><h2>Queue</h2><p>คิวรับสินค้าและจอแสดงผล</p><span class="coming-soon">กำลังพัฒนา</span></article>
      </section>
    </main>
  </div>
  <script>
    import { api, ApiError } from "../../lib/api";
    import type { SessionPrincipal, StoreSummary } from "@aevo/contracts";

    const error = document.querySelector<HTMLParagraphElement>("#error")!;
    const params = new URLSearchParams(window.location.search);
    const selectedStoreId = params.get("store") || sessionStorage.getItem("aevo.selectedStoreId");

    try {
      const [{ user }, { stores }] = await Promise.all([
        api<{ user: SessionPrincipal }>("/api/auth/me"),
        api<{ stores: StoreSummary[] }>("/api/stores")
      ]);
      const store = stores.find((item) => item.id === selectedStoreId);
      if (!store) {
        window.location.assign("/staff");
      } else {
        sessionStorage.setItem("aevo.selectedStoreId", store.id);
        document.querySelector<HTMLAnchorElement>("#catalog-link")!.href = `/staff/catalog?store=${encodeURIComponent(store.id)}`;
        document.querySelector("#welcome")!.textContent = `สวัสดี ${user.displayName || user.email}`;
        document.querySelector("#store-summary")!.textContent = `${store.name} · ${store.code} · ${store.timezone}`;
      }
    } catch (cause) {
      if (cause instanceof ApiError && cause.code === "UNAUTHORIZED") window.location.assign("/login");
      else { error.textContent = cause instanceof Error ? cause.message : "โหลด workspace ไม่สำเร็จ"; error.hidden = false; }
    }

    document.querySelector("#logout")!.addEventListener("click", async () => {
      await api("/api/auth/logout", { method: "POST" }).catch(() => undefined);
      sessionStorage.removeItem("aevo.selectedStoreId");
      window.location.assign("/login");
    });
  </script>
  <style>
    .brand-link { text-decoration: none; }
    .header-actions { display: flex; align-items: center; gap: 16px; }
    .back { display: inline-block; margin-bottom: 22px; color: var(--brand); font-weight: 750; text-decoration: none; }
    .workspace-grid { margin-top: 30px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
    .workspace-card { min-height: 210px; padding: 24px; display: flex; flex-direction: column; align-items: flex-start; }
    .workspace-link { color: inherit; text-decoration: none; }
    .workspace-card h2 { margin: 14px 0 4px; }
    .workspace-card p { margin: 0 0 20px; color: var(--muted); line-height: 1.5; }
    .workspace-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; color: white; background: var(--brand); font-size: 1.35rem; }
    .coming-soon { margin-top: auto; padding: 5px 9px; border-radius: 999px; color: var(--brand); background: #e7f2ed; font-size: .76rem; font-weight: 800; }
    .coming-soon.ready { color: #8a5e00; background: #fff4cf; }
    @media (max-width: 520px) { .status { display: none; } }
  </style>
</BaseLayout>
