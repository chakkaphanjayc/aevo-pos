---
import StaffIcon from "../../components/staff/StaffIcon.astro";
import StaffShell from "../../components/staff/StaffShell.astro";
---

<StaffShell title="สินค้าและเมนู" active="catalog">
  <div class="staff-page catalog-page" id="catalog-page">
    <div class="staff-page-header catalog-header">
      <div class="staff-page-heading">
        <p class="staff-eyebrow">Catalog · Store setup</p>
        <h1 class="staff-page-title" id="catalog-page-title">สินค้า</h1>
        <p class="staff-page-lede" id="store-summary">กำลังโหลดเมนูของสาขา…</p>
      </div>
      <div class="catalog-header-actions">
        <button class="button secondary" id="refresh" type="button" aria-label="รีเฟรชข้อมูล"><StaffIcon name="refresh" size={16} /><span>รีเฟรช</span></button>
        <button class="button" id="primary-add" type="button"><StaffIcon name="plus" size={17} /><span>เพิ่มสินค้า</span></button>
      </div>
    </div>

    <p class="error" id="error" role="alert" hidden></p>
    <p class="success" id="success" role="status" aria-live="polite" hidden></p>

    <nav class="catalog-tabs" id="catalog-tabs" role="tablist" aria-label="ส่วนของ Catalog">
      <button class="catalog-tab is-active" data-tab="products" type="button" role="tab" aria-selected="true"><StaffIcon name="catalog" size={17} /><span>สินค้า</span><b id="tab-products-count">—</b></button>
      <button class="catalog-tab" data-tab="categories" type="button" role="tab" aria-selected="false"><StaffIcon name="tag" size={17} /><span>หมวดหมู่</span><b id="tab-categories-count">—</b></button>
      <button class="catalog-tab" data-tab="menus" type="button" role="tab" aria-selected="false"><StaffIcon name="layers" size={17} /><span>เมนู</span><b id="tab-menus-count">—</b></button>
      <button class="catalog-tab" data-tab="modifiers" type="button" role="tab" aria-selected="false"><StaffIcon name="sliders" size={17} /><span>กลุ่มตัวเลือก</span><b id="tab-modifiers-count">—</b></button>
      <button class="catalog-tab" data-tab="availability" type="button" role="tab" aria-selected="false"><StaffIcon name="check" size={17} /><span>การขาย</span></button>
    </nav>

    <section class="catalog-panel" id="products-panel" data-tab-panel="products" role="tabpanel">
      <div class="catalog-panel-heading"><div><span class="staff-eyebrow">Product list</span><h2>สินค้าในร้าน</h2></div><span class="catalog-result-count" id="product-result-count">กำลังโหลด…</span></div>
      <div class="catalog-toolbar">
        <label class="catalog-search"><StaffIcon name="search" size={17} /><span class="sr-only">ค้นหาสินค้า</span><input id="product-search" type="search" placeholder="ค้นหาชื่อสินค้า หรือ SKU…" autocomplete="off" /></label>
        <label class="catalog-filter"><span class="sr-only">หมวดหมู่</span><select id="category-filter" aria-label="กรองหมวดหมู่"><option value="">ทุกหมวดหมู่</option></select></label>
        <label class="catalog-filter"><span class="sr-only">สถานะสินค้า</span><select id="status-filter" aria-label="กรองสถานะ"><option value="ACTIVE">เปิดใช้งาน</option><option value="ALL">ทุกสถานะ</option><option value="ARCHIVED">เก็บถาวร</option></select></label>
        <label class="catalog-filter"><span class="sr-only">การขาย</span><select id="availability-filter" aria-label="กรองการขาย"><option value="ALL">ทุกการขาย</option><option value="AVAILABLE">เปิดขาย</option><option value="SOLD_OUT">Sold out</option><option value="HIDDEN">ปิดการขาย</option></select></label>
        <label class="catalog-filter catalog-channel-filter"><span class="sr-only">ช่องทาง</span><select id="channel-filter" aria-label="กรองช่องทาง"><option value="POS">POS</option><option value="QR">QR</option><option value="KIOSK">Kiosk</option><option value="PICKUP">Pickup</option></select></label>
        <label class="catalog-filter catalog-sort"><span class="sr-only">เรียงตาม</span><select id="sort-filter" aria-label="เรียงตาม"><option value="name">ชื่อสินค้า</option><option value="price-low">ราคาต่ำไปสูง</option><option value="price-high">ราคาสูงไปต่ำ</option><option value="sku">SKU</option></select></label>
        <div class="catalog-view-toggle" role="group" aria-label="รูปแบบการแสดงผล"><button class="view-button is-active" id="table-view" type="button" aria-label="มุมมองตาราง" aria-pressed="true"><StaffIcon name="list" size={17} /></button><button class="view-button" id="grid-view" type="button" aria-label="มุมมองกริด" aria-pressed="false"><StaffIcon name="grid" size={17} /></button></div>
      </div>
      <div class="catalog-list" id="product-list" aria-live="polite"><div class="catalog-skeleton-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div><div class="catalog-skeleton-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div></div>
    </section>

    <section class="catalog-panel" id="categories-panel" data-tab-panel="categories" role="tabpanel" hidden>
      <div class="catalog-panel-heading"><div><span class="staff-eyebrow">Product taxonomy</span><h2>หมวดหมู่</h2><p>จัดกลุ่มสินค้าให้ทีมหน้าร้านค้นหาได้เร็วขึ้น</p></div><button class="button" id="add-category" type="button"><StaffIcon name="plus" size={17} />เพิ่มหมวดหมู่</button></div>
      <div class="category-summary-strip"><span><strong id="category-active-count">—</strong> หมวดหมู่ที่ใช้งาน</span><span>จำนวนสินค้าคำนวณจาก Catalog ปัจจุบัน</span></div>
      <div class="category-list" id="category-list" aria-live="polite"></div>
    </section>

    <section class="catalog-panel" id="menus-panel" data-tab-panel="menus" role="tabpanel" hidden>
      <div class="catalog-panel-heading"><div><span class="staff-eyebrow">Channel menus</span><h2>เมนูของสาขา</h2><p>แยกเมนูตามช่องทาง และเลือกสินค้าที่ต้องการให้แสดง</p></div><button class="button" id="add-menu" type="button"><StaffIcon name="plus" size={17} />เพิ่มเมนู</button></div>
      <div class="menu-list" id="menu-list" aria-live="polite"></div>
    </section>

    <section class="catalog-panel" id="modifiers-panel" data-tab-panel="modifiers" role="tabpanel" hidden>
      <div class="catalog-panel-heading"><div><span class="staff-eyebrow">Product options</span><h2>กลุ่มตัวเลือก</h2><p>เช่น ขนาด อุณหภูมิ นม หรือท็อปปิ้ง</p></div><button class="button" id="add-modifier" type="button"><StaffIcon name="plus" size={17} />เพิ่มกลุ่มตัวเลือก</button></div>
      <div class="modifier-list" id="modifier-list" aria-live="polite"></div>
    </section>

    <section class="catalog-panel" id="availability-panel" data-tab-panel="availability" role="tabpanel" hidden>
      <div class="catalog-panel-heading"><div><span class="staff-eyebrow">Channel availability</span><h2>การขายแยกตามช่องทาง</h2><p>กดสถานะเพื่อเปิด/ปิดการขายของสินค้าในแต่ละช่องทาง</p></div><span class="catalog-result-count">แตะสถานะเพื่อเปลี่ยน</span></div>
      <div class="availability-table-wrap" id="availability-list" aria-live="polite"></div>
    </section>
  </div>

  <dialog class="catalog-drawer" id="product-drawer" aria-labelledby="product-drawer-title">
    <div class="catalog-drawer-card">
      <div class="catalog-drawer-heading"><div><span class="staff-eyebrow" id="product-drawer-eyebrow">New product</span><h2 id="product-drawer-title">เพิ่มสินค้า</h2></div><button class="staff-icon-button" data-close-dialog="product-drawer" type="button" aria-label="ปิด"><StaffIcon name="close" size={18} /></button></div>
      <form class="catalog-drawer-form" id="product-form">
        <div class="drawer-form-section"><div class="drawer-section-heading"><strong>ข้อมูลพื้นฐาน</strong><span>ข้อมูลที่ทีมหน้าร้านเห็น</span></div>
          <label>ชื่อสินค้า <span class="required-mark">*</span><input id="product-name" required maxlength="160" placeholder="เช่น ลาเต้เย็น" /></label>
          <div class="drawer-form-row"><label>SKU <span class="required-mark">*</span><input id="product-sku" required maxlength="64" placeholder="LATTE-ICED" /></label><label>หมวดหมู่<select id="product-category"><option value="">ไม่ระบุหมวดหมู่</option></select></label></div>
          <label>รายละเอียด<textarea id="product-description" maxlength="2000" rows="3" placeholder="รายละเอียดสั้น ๆ สำหรับทีมหน้าร้าน"></textarea></label>
        </div>
        <div class="drawer-form-section"><div class="drawer-section-heading"><strong>ราคา</strong><span>เก็บเป็นสตางค์ในระบบ</span></div><label>ราคาขาย <span class="required-mark">*</span><div class="money-input"><input id="product-price" required inputmode="decimal" min="0" step="0.01" type="number" placeholder="65.00" /><span>บาท</span></div></label></div>
        <div class="drawer-form-section"><div class="drawer-section-heading"><strong>Variants</strong><span id="variant-helper">เพิ่มขนาดหรือราคาที่แตกต่างกัน</span></div><div class="variant-list" id="variant-list"></div><button class="drawer-add-line" id="add-variant" type="button"><StaffIcon name="plus" size={15} />เพิ่ม variant</button><p class="drawer-note" id="variant-note" hidden></p></div>
        <div class="drawer-form-section"><div class="drawer-section-heading"><strong>ช่องทางการขาย</strong><span>เริ่มต้นเปิด POS, QR, Kiosk และ Pickup</span></div><div class="channel-checks" id="channel-checks"></div></div>
        <div class="drawer-form-section"><div class="drawer-section-heading"><strong>กลุ่มตัวเลือก</strong><span>แสดงบน POS เมื่อเลือกสินค้า</span></div><div class="modifier-checks" id="product-modifier-checks"></div></div>
        <p class="drawer-error" id="product-form-error" role="alert" hidden></p>
        <div class="catalog-drawer-footer"><button class="button secondary" data-close-dialog="product-drawer" type="button">ยกเลิก</button><button class="button" id="product-submit" type="submit">บันทึกสินค้า</button></div>
      </form>
    </div>
  </dialog>

  <dialog class="catalog-modal" id="category-dialog" aria-labelledby="category-dialog-title"><div class="catalog-modal-card"><div class="catalog-drawer-heading"><div><span class="staff-eyebrow">Product taxonomy</span><h2 id="category-dialog-title">เพิ่มหมวดหมู่</h2></div><button class="staff-icon-button" data-close-dialog="category-dialog" type="button" aria-label="ปิด"><StaffIcon name="close" size={18} /></button></div><form class="catalog-modal-form" id="category-form"><label>ชื่อหมวดหมู่ <span class="required-mark">*</span><input id="category-name" required maxlength="160" placeholder="เช่น กาแฟ" /></label><label>รหัสหมวดหมู่<input id="category-code" maxlength="32" placeholder="COFFEE" /></label><label>หมวดหมู่หลัก<select id="category-parent"><option value="">ไม่มีหมวดหมู่หลัก</option></select></label><p class="drawer-error" id="category-form-error" role="alert" hidden></p><div class="catalog-drawer-footer"><button class="button secondary" data-close-dialog="category-dialog" type="button">ยกเลิก</button><button class="button" type="submit">เพิ่มหมวดหมู่</button></div></form></div></dialog>

  <dialog class="catalog-modal" id="menu-dialog" aria-labelledby="menu-dialog-title"><div class="catalog-modal-card"><div class="catalog-drawer-heading"><div><span class="staff-eyebrow">Channel menu</span><h2 id="menu-dialog-title">เพิ่มเมนู</h2></div><button class="staff-icon-button" data-close-dialog="menu-dialog" type="button" aria-label="ปิด"><StaffIcon name="close" size={18} /></button></div><form class="catalog-modal-form" id="menu-form"><label>ชื่อเมนู <span class="required-mark">*</span><input id="menu-name" required maxlength="160" placeholder="เมนูหน้าร้าน" /></label><div class="drawer-form-row"><label>รหัสเมนู<input id="menu-code" maxlength="32" placeholder="POS-MAIN" /></label><label>ช่องทาง<select id="menu-channel"><option value="POS">POS</option><option value="QR">QR</option><option value="KIOSK">Kiosk</option><option value="PICKUP">Pickup</option></select></label></div><p class="drawer-error" id="menu-form-error" role="alert" hidden></p><div class="catalog-drawer-footer"><button class="button secondary" data-close-dialog="menu-dialog" type="button">ยกเลิก</button><button class="button" type="submit">เพิ่มเมนู</button></div></form></div></dialog>

  <dialog class="catalog-modal" id="modifier-dialog" aria-labelledby="modifier-dialog-title"><div class="catalog-modal-card"><div class="catalog-drawer-heading"><div><span class="staff-eyebrow">Product options</span><h2 id="modifier-dialog-title">เพิ่มกลุ่มตัวเลือก</h2></div><button class="staff-icon-button" data-close-dialog="modifier-dialog" type="button" aria-label="ปิด"><StaffIcon name="close" size={18} /></button></div><form class="catalog-modal-form" id="modifier-form"><label>ชื่อกลุ่มตัวเลือก <span class="required-mark">*</span><input id="modifier-name" required maxlength="160" placeholder="เช่น ประเภทนม" /></label><div class="drawer-form-row"><label>รูปแบบ<select id="modifier-type"><option value="SINGLE">เลือกได้ 1 รายการ</option><option value="MULTIPLE">เลือกได้หลายรายการ</option></select></label><label class="checkbox-field"><input id="modifier-required" type="checkbox" /> จำเป็นต้องเลือก</label></div><label>รายการตัวเลือก <span class="field-hint">หนึ่งรายการต่อบรรทัด · ชื่อ|ราคาเพิ่ม</span><textarea id="modifier-items" rows="5" placeholder="นมปกติ|0&#10;นมโอ๊ต|20&#10;นมอัลมอนด์|25"></textarea></label><p class="drawer-error" id="modifier-form-error" role="alert" hidden></p><div class="catalog-drawer-footer"><button class="button secondary" data-close-dialog="modifier-dialog" type="button">ยกเลิก</button><button class="button" type="submit">เพิ่มกลุ่มตัวเลือก</button></div></form></div></dialog>

  <dialog class="catalog-modal" id="menu-item-dialog" aria-labelledby="menu-item-dialog-title"><div class="catalog-modal-card"><div class="catalog-drawer-heading"><div><span class="staff-eyebrow">Menu item</span><h2 id="menu-item-dialog-title">เพิ่มสินค้าในเมนู</h2></div><button class="staff-icon-button" data-close-dialog="menu-item-dialog" type="button" aria-label="ปิด"><StaffIcon name="close" size={18} /></button></div><form class="catalog-modal-form" id="menu-item-form"><p class="menu-item-context" id="menu-item-context"></p><label>สินค้า <span class="required-mark">*</span><select id="menu-item-product" required></select></label><label>Variant<select id="menu-item-variant"><option value="">ใช้ราคาหลัก</option></select></label><label>ราคาเฉพาะเมนู <span class="field-hint">เว้นว่างเพื่อใช้ราคาสินค้า</span><div class="money-input"><input id="menu-item-price" inputmode="decimal" min="0" step="0.01" type="number" placeholder="ไม่ระบุ" /><span>บาท</span></div></label><p class="drawer-error" id="menu-item-form-error" role="alert" hidden></p><div class="catalog-drawer-footer"><button class="button secondary" data-close-dialog="menu-item-dialog" type="button">ยกเลิก</button><button class="button" type="submit">เพิ่มในเมนู</button></div></form></div></dialog>

  <script>
    import { api, ApiError } from "../../lib/api";
    import { cacheCatalog, getCachedCatalog } from "../../lib/idb-cache";
    import { friendlyErrorMessage, getSelectedStoreId, findSelectedStore, initStaffShell, loadStaffContext, storeUrl } from "../../lib/staff-ui";
    import type { CatalogChannel, CatalogSnapshot, CategorySummary, MenuSummary, ProductAvailabilitySummary, ProductSummary, StoreSummary } from "@aevo/contracts";

    type CatalogTab = "products" | "categories" | "menus" | "modifiers" | "availability";
    type ViewMode = "table" | "grid";
    const channelOptions = ["POS", "QR", "KIOSK", "PICKUP"] as const;
    type StoreChannel = (typeof channelOptions)[number];
    const tabTitles: Record<CatalogTab, string> = { products: "สินค้า", categories: "หมวดหมู่", menus: "เมนู", modifiers: "กลุ่มตัวเลือก", availability: "การขาย" };

    const page = document.querySelector<HTMLElement>("#catalog-page")!;
    const error = document.querySelector<HTMLParagraphElement>("#error")!;
    const success = document.querySelector<HTMLParagraphElement>("#success")!;
    const refresh = document.querySelector<HTMLButtonElement>("#refresh")!;
    const primaryAdd = document.querySelector<HTMLButtonElement>("#primary-add")!;
    const productList = document.querySelector<HTMLElement>("#product-list")!;
    const productSearch = document.querySelector<HTMLInputElement>("#product-search")!;
    const categoryFilter = document.querySelector<HTMLSelectElement>("#category-filter")!;
    const statusFilter = document.querySelector<HTMLSelectElement>("#status-filter")!;
    const availabilityFilter = document.querySelector<HTMLSelectElement>("#availability-filter")!;
    const channelFilter = document.querySelector<HTMLSelectElement>("#channel-filter")!;
    const sortFilter = document.querySelector<HTMLSelectElement>("#sort-filter")!;
    const tableView = document.querySelector<HTMLButtonElement>("#table-view")!;
    const gridView = document.querySelector<HTMLButtonElement>("#grid-view")!;
    const productDrawer = document.querySelector<HTMLDialogElement>("#product-drawer")!;
    const productForm = document.querySelector<HTMLFormElement>("#product-form")!;
    const requestedStoreId = getSelectedStoreId();
    let selectedStoreId = "";
    let stores: StoreSummary[] = [];
    let catalog: CatalogSnapshot | null = null;
    let currentTab: CatalogTab = getTabFromUrl();
    let viewMode: ViewMode = localStorage.getItem("aevo.catalog.view") === "grid" ? "grid" : "table";
    let productEditId: string | null = null;
    let highlightProductId = "";
    let loading = true;
    let catalogLoadVersion = 0;

    function getTabFromUrl(): CatalogTab {
      const value = new URLSearchParams(window.location.search).get("tab");
      return value === "categories" || value === "menus" || value === "modifiers" || value === "availability" ? value : "products";
    }

    function money(minor: number, currency = "THB"): string {
      return new Intl.NumberFormat("th-TH", { style: "currency", currency }).format(minor / 100);
    }

    function escapeHtml(value: string): string {
      const element = document.createElement("span");
      element.textContent = value;
      return element.innerHTML;
    }

    function showError(cause: unknown, fallback = "เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง"): void {
      error.textContent = friendlyErrorMessage(cause, fallback);
      error.hidden = false;
      success.hidden = true;
    }

    function showSuccess(message: string): void {
      success.textContent = message;
      success.hidden = false;
      error.hidden = true;
      window.setTimeout(() => { success.hidden = true; }, 2800);
    }

    function setLoading(next: boolean): void {
      loading = next;
      refresh.disabled = next;
      page.classList.toggle("is-loading", next);
      if (next) {
        productList.innerHTML = '<div class="catalog-skeleton-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div><div class="catalog-skeleton-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div><div class="catalog-skeleton-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div>';
      }
    }

    function getCategory(categoryId?: string): CategorySummary | undefined {
      return catalog?.categories.find((category) => category.id === categoryId);
    }

    function getAvailability(product: ProductSummary, channel: string): ProductAvailabilitySummary {
      return product.availability.find((entry) => entry.channel === channel) ?? { channel: channel as CatalogChannel, isAvailable: true, soldOut: false };
    }

    function productAvailabilityLabel(product: ProductSummary, channel: string): { label: string; state: string } {
      const availability = getAvailability(product, channel);
      if (!availability.isAvailable) return { label: "ปิดขาย", state: "hidden" };
      if (availability.soldOut) return { label: "Sold out", state: "sold-out" };
      return { label: "เปิดขาย", state: "available" };
    }

    function renderFilterOptions(): void {
      if (!catalog) return;
      const selectedCategory = categoryFilter.value;
      categoryFilter.replaceChildren(new Option("ทุกหมวดหมู่", ""));
      for (const category of catalog.categories.filter((item) => item.status === "ACTIVE")) categoryFilter.add(new Option(category.name, category.id));
      categoryFilter.value = selectedCategory;
      const productCategory = document.querySelector<HTMLSelectElement>("#product-category")!;
      const currentProductCategory = productCategory.value;
      productCategory.replaceChildren(new Option("ไม่ระบุหมวดหมู่", ""));
      for (const category of catalog.categories.filter((item) => item.status === "ACTIVE")) productCategory.add(new Option(category.name, category.id));
      productCategory.value = currentProductCategory;
      const parent = document.querySelector<HTMLSelectElement>("#category-parent")!;
      const currentParent = parent.value;
      parent.replaceChildren(new Option("ไม่มีหมวดหมู่หลัก", ""));
      for (const category of catalog.categories.filter((item) => item.status === "ACTIVE")) parent.add(new Option(category.name, category.id));
      parent.value = currentParent;
    }

    function filteredProducts(): ProductSummary[] {
      if (!catalog) return [];
      const needle = productSearch.value.trim().toLowerCase();
      const products = catalog.products.filter((product) => {
        const statusMatch = statusFilter.value === "ALL" || product.status === statusFilter.value;
        const categoryMatch = !categoryFilter.value || product.categoryId === categoryFilter.value;
        const availability = getAvailability(product, channelFilter.value);
        const availabilityMatch = availabilityFilter.value === "ALL" || (availabilityFilter.value === "AVAILABLE" && availability.isAvailable && !availability.soldOut) || (availabilityFilter.value === "SOLD_OUT" && availability.soldOut) || (availabilityFilter.value === "HIDDEN" && !availability.isAvailable);
        const searchMatch = !needle || `${product.name} ${product.sku} ${getCategory(product.categoryId)?.name ?? ""}`.toLowerCase().includes(needle);
        return statusMatch && categoryMatch && availabilityMatch && searchMatch;
      });
      return products.sort((a, b) => {
        if (sortFilter.value === "price-low") return a.basePriceMinor - b.basePriceMinor;
        if (sortFilter.value === "price-high") return b.basePriceMinor - a.basePriceMinor;
        if (sortFilter.value === "sku") return a.sku.localeCompare(b.sku);
        return a.name.localeCompare(b.name, "th");
      });
    }

    function productMarkup(product: ProductSummary, mode: ViewMode): string {
      const category = getCategory(product.categoryId)?.name ?? "ไม่ระบุหมวดหมู่";
      const availability = productAvailabilityLabel(product, channelFilter.value);
      const posAvailability = getAvailability(product, "POS");
      const variantLabel = product.variants.length > 1 ? `${product.variants.length} variants` : product.variants[0]?.name === "Standard" ? "Standard" : `${product.variants.length} variant`;
      const archived = product.status === "ARCHIVED";
      const actionLabel = !posAvailability.isAvailable ? "เปิดขาย" : posAvailability.soldOut ? "ยกเลิก Sold out" : "ตั้ง Sold out";
      const status = archived ? "เก็บถาวร" : "เปิดใช้งาน";
      const html = `
        <div class="product-leading"><span class="product-thumb" aria-hidden="true">${escapeHtml(product.name.slice(0, 1))}</span><span class="product-main-copy"><strong>${escapeHtml(product.name)}</strong><small>${escapeHtml(product.sku)}</small></span></div>
        <span class="product-category-cell">${escapeHtml(category)}</span>
        <span class="product-price-cell">${money(product.basePriceMinor, product.currency)}</span>
        <span class="product-variant-cell">${escapeHtml(variantLabel)}</span>
        <span class="availability-badge" data-state="${availability.state}">${availability.label}</span>
        <span class="product-status-text" data-status="${product.status}">${status}</span>
        <span class="product-actions"><button class="product-action-link" data-product-action="edit" data-product-id="${product.id}" type="button">แก้ไข</button><button class="product-action-link quiet" data-product-action="toggle" data-product-id="${product.id}" type="button">${actionLabel}</button><button class="product-action-link danger" data-product-action="archive" data-product-id="${product.id}" type="button">${archived ? "เปิดใช้งาน" : "เก็บถาวร"}</button></span>
      `;
      if (mode === "grid") {
        return `<article class="product-card surface${highlightProductId === product.id ? " is-highlighted" : ""}${archived ? " is-archived" : ""}" data-product-card="${product.id}"><div class="product-card-top"><span class="product-thumb product-thumb-large" aria-hidden="true">${escapeHtml(product.name.slice(0, 1))}</span><span class="availability-badge" data-state="${availability.state}">${availability.label}</span></div><div class="product-card-copy"><span class="product-card-category">${escapeHtml(category)}</span><h3>${escapeHtml(product.name)}</h3><p>${escapeHtml(product.sku)} · ${escapeHtml(variantLabel)}</p></div><div class="product-card-bottom"><strong>${money(product.basePriceMinor, product.currency)}</strong><span class="product-status-text" data-status="${product.status}">${status}</span></div><div class="product-card-actions"><button class="button small secondary" data-product-action="edit" data-product-id="${product.id}" type="button">แก้ไข</button><button class="button small quiet" data-product-action="toggle" data-product-id="${product.id}" type="button">${actionLabel}</button><button class="icon-action danger" data-product-action="archive" data-product-id="${product.id}" type="button" aria-label="${archived ? "เปิดใช้งาน" : "เก็บถาวร"}"><span aria-hidden="true">▣</span></button></div></article>`;
      }
      return `<div class="product-row${highlightProductId === product.id ? " is-highlighted" : ""}${archived ? " is-archived" : ""}" data-product-card="${product.id}">${html}</div>`;
    }

    function renderProducts(): void {
      const products = filteredProducts();
      document.querySelector<HTMLElement>("#tab-products-count")!.textContent = catalog ? String(catalog.products.length) : "—";
      document.querySelector<HTMLElement>("#product-result-count")!.textContent = catalog ? `${products.length} จาก ${catalog.products.length} สินค้า` : "กำลังโหลด…";
      if (loading) return;
      if (!catalog || !products.length) {
        productList.className = "catalog-list";
        productList.innerHTML = `<div class="empty-state product-empty"><span class="product-empty-icon">▤</span><strong>${catalog?.products.length ? "ไม่พบสินค้าที่ตรงกับตัวกรอง" : "ยังไม่มีสินค้า"}</strong><p>${catalog?.products.length ? "ลองเปลี่ยนคำค้นหา หมวดหมู่ หรือสถานะการขาย" : "เพิ่มสินค้าแรกเพื่อเริ่มใช้งาน POS และเมนูของร้าน"}</p><button class="button" data-empty-add="true" type="button">+ เพิ่มสินค้า</button></div>`;
        productList.querySelector<HTMLButtonElement>("[data-empty-add]")?.addEventListener("click", () => openProductDrawer());
        return;
      }
      productList.className = `catalog-list ${viewMode === "grid" ? "is-grid" : "is-table"}`;
      if (viewMode === "table") {
        productList.innerHTML = `<div class="product-table-head"><span>สินค้า</span><span>หมวดหมู่</span><span>ราคา</span><span>Variants</span><span>การขาย</span><span>สถานะ</span><span></span></div>${products.map((product) => productMarkup(product, "table")).join("")}`;
      } else {
        productList.innerHTML = products.map((product) => productMarkup(product, "grid")).join("");
      }
      if (highlightProductId) {
        window.setTimeout(() => { document.querySelector<HTMLElement>(`[data-product-card="${CSS.escape(highlightProductId)}"]`)?.classList.remove("is-highlighted"); highlightProductId = ""; }, 1800);
      }
      bindProductActions();
    }

    function bindProductActions(): void {
      productList.querySelectorAll<HTMLButtonElement>("[data-product-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const product = catalog?.products.find((item) => item.id === button.dataset.productId);
          if (!product) return;
          if (button.dataset.productAction === "edit") openProductDrawer(product);
          if (button.dataset.productAction === "toggle") void togglePosAvailability(product);
          if (button.dataset.productAction === "archive") void toggleProductArchive(product);
        });
      });
    }

    async function togglePosAvailability(product: ProductSummary): Promise<void> {
      const current = getAvailability(product, "POS");
      const body = !current.isAvailable ? { isAvailable: true, soldOut: false } : { soldOut: !current.soldOut };
      try {
        await api(`/api/catalog/products/${product.id}/availability`, { method: "PATCH", body: JSON.stringify({ storeId: selectedStoreId, channel: "POS", ...body }) });
        await loadCatalog();
        showSuccess(body.soldOut ? "ตั้งสินค้าเป็น Sold out แล้ว" : "เปิดขายสินค้าแล้ว");
      } catch (cause) { showError(cause, "อัปเดตสถานะการขายไม่สำเร็จ"); }
    }

    async function toggleProductArchive(product: ProductSummary): Promise<void> {
      const nextStatus = product.status === "ARCHIVED" ? "ACTIVE" : "ARCHIVED";
      if (nextStatus === "ARCHIVED" && !window.confirm(`เก็บสินค้า “${product.name}” ไว้ในรายการเก็บถาวรหรือไม่`)) return;
      try {
        await api(`/api/catalog/products/${product.id}?storeId=${encodeURIComponent(selectedStoreId)}`, { method: "PATCH", body: JSON.stringify({ status: nextStatus }) });
        await loadCatalog();
        showSuccess(nextStatus === "ARCHIVED" ? "เก็บสินค้าแล้ว" : "เปิดใช้งานสินค้าแล้ว");
      } catch (cause) { showError(cause, "อัปเดตสถานะสินค้าไม่สำเร็จ"); }
    }

    function renderCategories(): void {
      if (!catalog) return;
      const counts = new Map<string, number>();
      for (const product of catalog.products) if (product.categoryId) counts.set(product.categoryId, (counts.get(product.categoryId) ?? 0) + 1);
      document.querySelector<HTMLElement>("#tab-categories-count")!.textContent = String(catalog.categories.length);
      document.querySelector<HTMLElement>("#category-active-count")!.textContent = String(catalog.categories.filter((item) => item.status === "ACTIVE").length);
      const list = document.querySelector<HTMLElement>("#category-list")!;
      if (!catalog.categories.length) { list.innerHTML = '<div class="empty-state"><strong>ยังไม่มีหมวดหมู่</strong><p>เริ่มต้นด้วยการเพิ่มหมวดหมู่แรก แล้วใช้กรองสินค้าได้ทันที</p><button class="button" data-category-empty-add type="button">เพิ่มหมวดหมู่</button></div>'; list.querySelector("button")?.addEventListener("click", () => openDialog("category-dialog")); return; }
      list.innerHTML = catalog.categories.map((category) => `<div class="category-row"><span class="category-row-icon">#</span><span class="category-row-main"><strong>${escapeHtml(category.name)}</strong><small>${escapeHtml(category.code)}${category.parentId ? " · มีหมวดหมู่หลัก" : ""}</small></span><span class="category-row-count"><strong>${counts.get(category.id) ?? 0}</strong><small>สินค้า</small></span><span class="category-row-status" data-status="${category.status}">${category.status === "ACTIVE" ? "เปิดใช้งาน" : "ปิดใช้งาน"}</span></div>`).join("");
    }

    function renderMenus(): void {
      if (!catalog) return;
      document.querySelector<HTMLElement>("#tab-menus-count")!.textContent = String(catalog.menus.length);
      const list = document.querySelector<HTMLElement>("#menu-list")!;
      if (!catalog.menus.length) { list.innerHTML = '<div class="empty-state"><strong>ยังไม่มีเมนูของสาขา</strong><p>เพิ่มเมนูเพื่อจัดชุดสินค้าให้เหมาะกับ POS, QR หรือ Kiosk</p><button class="button" data-menu-empty-add type="button">เพิ่มเมนู</button></div>'; list.querySelector("button")?.addEventListener("click", () => openDialog("menu-dialog")); return; }
      list.innerHTML = catalog.menus.map((menu) => `<article class="menu-row surface"><div class="menu-row-main"><span class="menu-row-icon">≡</span><span><strong>${escapeHtml(menu.name)}</strong><small>${escapeHtml(menu.code)} · ${escapeHtml(menu.channel)}</small></span></div><span class="menu-row-stat"><strong>${menu.items.length}</strong><small>รายการ</small></span><span class="category-row-status" data-status="${menu.status}">${menu.status === "ACTIVE" ? "เปิดใช้งาน" : "ปิดใช้งาน"}</span><button class="button small secondary" data-menu-action="add-item" data-menu-id="${menu.id}" type="button">เพิ่มสินค้า</button></article>`).join("");
      list.querySelectorAll<HTMLButtonElement>("[data-menu-action='add-item']").forEach((button) => button.addEventListener("click", () => { const menu = catalog?.menus.find((item) => item.id === button.dataset.menuId); if (menu) openMenuItemDialog(menu); }));
    }

    function renderModifiers(): void {
      if (!catalog) return;
      document.querySelector<HTMLElement>("#tab-modifiers-count")!.textContent = String(catalog.modifierGroups.length);
      const list = document.querySelector<HTMLElement>("#modifier-list")!;
      if (!catalog.modifierGroups.length) { list.innerHTML = '<div class="empty-state"><strong>ยังไม่มีกลุ่มตัวเลือก</strong><p>เพิ่มขนาด อุณหภูมิ หรือตัวเลือกอื่นเพื่อใช้ใน POS</p><button class="button" data-modifier-empty-add type="button">เพิ่มกลุ่มตัวเลือก</button></div>'; list.querySelector("button")?.addEventListener("click", () => openDialog("modifier-dialog")); return; }
      list.innerHTML = catalog.modifierGroups.map((group) => { const rule = group.selectionType === "SINGLE" ? "เลือกได้ 1 รายการ" : `เลือกได้หลายรายการ${group.maxSelections < 99 ? ` · สูงสุด ${group.maxSelections}` : ""}`; return `<article class="modifier-row surface"><div class="modifier-row-main"><span class="modifier-row-icon">◌</span><span><strong>${escapeHtml(group.name)}</strong><small>${escapeHtml(group.code)} · ${rule}</small></span></div><span class="menu-row-stat"><strong>${group.modifiers.length}</strong><small>ตัวเลือก</small></span><span class="modifier-required" data-required="${group.required}">${group.required ? "จำเป็นต้องเลือก" : "เลือกได้"}</span><div class="modifier-options-preview">${group.modifiers.slice(0, 4).map((modifier) => `<span>${escapeHtml(modifier.name)}${modifier.priceDeltaMinor ? ` +${money(modifier.priceDeltaMinor)}` : ""}</span>`).join("") || "ยังไม่มีตัวเลือก"}</div></article>`; }).join("");
    }

    function renderAvailability(): void {
      if (!catalog) return;
      const list = document.querySelector<HTMLElement>("#availability-list")!;
      if (!catalog.products.length) { list.innerHTML = '<div class="empty-state"><strong>ยังไม่มีสินค้า</strong><p>เพิ่มสินค้าเพื่อจัดการการขายตามช่องทาง</p></div>'; return; }
      list.innerHTML = `<div class="availability-table"><div class="availability-head"><span>สินค้า</span>${channelOptions.map((channel) => `<span>${channel}</span>`).join("")}</div>${catalog.products.map((product) => `<div class="availability-row"><span class="availability-product"><span class="product-thumb">${escapeHtml(product.name.slice(0, 1))}</span><span><strong>${escapeHtml(product.name)}</strong><small>${escapeHtml(product.sku)}</small></span></span>${channelOptions.map((channel) => { const availability = getAvailability(product, channel); const state = !availability.isAvailable ? "hidden" : availability.soldOut ? "sold-out" : "available"; const label = !availability.isAvailable ? "ปิด" : availability.soldOut ? "หมด" : "เปิด"; return `<button class="availability-toggle" data-availability-product="${product.id}" data-availability-channel="${channel}" data-availability="${state}" type="button"><span>${label}</span><small>${availability.soldOut ? "Sold out" : availability.isAvailable ? "เปิดขาย" : "ปิดขาย"}</small></button>`; }).join("")}</div>`).join("")}</div>`;
      list.querySelectorAll<HTMLButtonElement>("[data-availability-product]").forEach((button) => button.addEventListener("click", () => void toggleChannel(button.dataset.availabilityProduct!, button.dataset.availabilityChannel as StoreChannel)));
    }

    async function toggleChannel(productId: string, channel: StoreChannel): Promise<void> {
      const product = catalog?.products.find((item) => item.id === productId);
      if (!product) return;
      const current = getAvailability(product, channel);
      try {
        await api(`/api/catalog/products/${productId}/availability`, { method: "PATCH", body: JSON.stringify({ storeId: selectedStoreId, channel, isAvailable: !current.isAvailable, soldOut: current.isAvailable ? current.soldOut : false }) });
        await loadCatalog();
        showSuccess(`อัปเดตการขายช่องทาง ${channel} แล้ว`);
      } catch (cause) { showError(cause, "อัปเดตการขายไม่สำเร็จ"); }
    }

    function renderAll(): void {
      renderFilterOptions();
      renderProducts();
      renderCategories();
      renderMenus();
      renderModifiers();
      renderAvailability();
    }

    async function loadCatalog(): Promise<void> {
      if (!selectedStoreId) return;
      const loadVersion = ++catalogLoadVersion;
      const previousCatalog = catalog;
      const hadVisibleCatalog = catalog !== null;
      setLoading(!hadVisibleCatalog);
      let cachedShown = hadVisibleCatalog;
      try {
        if (!hadVisibleCatalog) {
          const cached = await getCachedCatalog(selectedStoreId).catch(() => null);
          if (loadVersion !== catalogLoadVersion) return;
          if (cached) {
            catalog = cached;
            cachedShown = true;
            setLoading(false);
            error.hidden = true;
            renderAll();
          }
        }

        const freshCatalog = await api<CatalogSnapshot>(`/api/catalog?storeId=${encodeURIComponent(selectedStoreId)}`);
        if (loadVersion !== catalogLoadVersion) return;
        catalog = freshCatalog;
        void cacheCatalog(selectedStoreId, freshCatalog).catch(() => undefined);
        error.hidden = true;
        renderAll();
      } catch (cause) {
        if (loadVersion !== catalogLoadVersion) return;
        catalog = null;
        if (cachedShown) {
          catalog = previousCatalog ?? await getCachedCatalog(selectedStoreId).catch(() => null);
          if (catalog) {
            showError(cause, "อัปเดตข้อมูลไม่ได้ จึงแสดงข้อมูลล่าสุดที่บันทึกไว้");
            renderAll();
            return;
          }
        }
        renderProducts();
        showError(cause, "โหลด Catalog ไม่สำเร็จ กรุณาลองใหม่");
        document.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((panel) => { if (panel.id !== "products-panel") panel.innerHTML = '<div class="empty-state"><strong>ยังโหลดข้อมูลไม่ได้</strong><p>ลองรีเฟรชอีกครั้งเมื่อการเชื่อมต่อพร้อม</p></div>'; });
      } finally {
        if (loadVersion === catalogLoadVersion) {
          setLoading(false);
          if (catalog) renderAll();
          else renderProducts();
        }
      }
    }

    function setTab(tab: CatalogTab, replace = false): void {
      currentTab = tab;
      const url = new URL(window.location.href);
      url.searchParams.set("tab", tab);
      if (selectedStoreId) url.searchParams.set("store", selectedStoreId);
      history[replace ? "replaceState" : "pushState"](null, "", `${url.pathname}${url.search}`);
      document.querySelector<HTMLElement>("#catalog-page-title")!.textContent = tabTitles[tab];
      document.querySelectorAll<HTMLButtonElement>(".catalog-tab").forEach((button) => { const active = button.dataset.tab === tab; button.classList.toggle("is-active", active); button.setAttribute("aria-selected", String(active)); });
      document.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((panel) => { panel.hidden = panel.dataset.tabPanel !== tab; });
      const addLabels: Record<CatalogTab, string> = { products: "เพิ่มสินค้า", categories: "เพิ่มหมวดหมู่", menus: "เพิ่มเมนู", modifiers: "เพิ่มกลุ่มตัวเลือก", availability: "" };
      primaryAdd.hidden = tab === "availability";
      primaryAdd.querySelector("span:last-child")!.textContent = addLabels[tab];
      const icon = tab === "products" ? "plus" : "plus";
      primaryAdd.innerHTML = `<span class="staff-icon-fallback">+</span><span>${addLabels[tab]}</span>`;
      primaryAdd.onclick = () => { if (tab === "products") openProductDrawer(); if (tab === "categories") openDialog("category-dialog"); if (tab === "menus") openDialog("menu-dialog"); if (tab === "modifiers") openDialog("modifier-dialog"); };
      void icon;
    }

    function openDialog(id: string): void { const dialog = document.querySelector<HTMLDialogElement>(`#${id}`); if (dialog && !dialog.open) dialog.showModal(); }
    function closeDialog(id: string): void { document.querySelector<HTMLDialogElement>(`#${id}`)?.close(); }

    function renderChannelChecks(product?: ProductSummary): void {
      const container = document.querySelector<HTMLElement>("#channel-checks")!;
      container.innerHTML = channelOptions.map((channel) => { const current = product ? getAvailability(product, channel) : { isAvailable: true }; const labels: Record<StoreChannel, string> = { POS: "POS", QR: "QR", KIOSK: "Kiosk", PICKUP: "Pickup" }; return `<label class="channel-check"><input type="checkbox" data-channel-check="${channel}" ${current.isAvailable ? "checked" : ""} /><span><strong>${labels[channel]}</strong><small>${channel === "POS" ? "หน้าร้าน" : channel === "QR" ? "สั่งผ่าน QR" : channel === "KIOSK" ? "ตู้สั่งซื้อ" : "รับสินค้า"}</small></span></label>`; }).join("");
    }

    function renderModifierChecks(product?: ProductSummary): void {
      const container = document.querySelector<HTMLElement>("#product-modifier-checks")!;
      if (!catalog?.modifierGroups.length) { container.innerHTML = '<p class="drawer-note">ยังไม่มีกลุ่มตัวเลือก เพิ่มกลุ่มตัวเลือกจากแท็บ “กลุ่มตัวเลือก” ก่อน</p>'; return; }
      const attached = new Set(catalog.productModifierGroups.filter((mapping) => mapping.productId === product?.id).map((mapping) => mapping.modifierGroupId));
      container.innerHTML = catalog.modifierGroups.filter((group) => group.status === "ACTIVE").map((group) => `<label class="modifier-check"><input type="checkbox" data-modifier-check="${group.id}" ${attached.has(group.id) ? "checked" : ""} /><span><strong>${escapeHtml(group.name)}</strong><small>${group.required ? "จำเป็นต้องเลือก" : "เลือกได้"} · ${group.modifiers.length} ตัวเลือก</small></span></label>`).join("");
    }

    function renderVariantRows(product?: ProductSummary): void {
      const list = document.querySelector<HTMLElement>("#variant-list")!;
      const addVariant = document.querySelector<HTMLButtonElement>("#add-variant")!;
      const helper = document.querySelector<HTMLElement>("#variant-helper")!;
      const note = document.querySelector<HTMLElement>("#variant-note")!;
      list.replaceChildren();
      if (product) {
        addVariant.hidden = true;
        helper.textContent = "ตัวเลือกที่มีอยู่ของสินค้า";
        note.hidden = false;
        note.textContent = "ระบบจะแสดง variant ที่มีอยู่ให้ดู แต่ API รุ่นนี้ยังไม่รองรับการแก้ไข variant ในหน้าแก้ไขสินค้า";
        for (const variant of product.variants) {
          const row = document.createElement("div"); row.className = "variant-row variant-row-readonly"; row.innerHTML = `<span><strong></strong><small></small></span><strong class="variant-row-price"></strong>`; row.querySelector("strong")!.textContent = variant.name; row.querySelector("small")!.textContent = variant.code; row.querySelector(".variant-row-price")!.textContent = money(variant.priceMinor, product.currency); list.append(row);
        }
        return;
      }
      addVariant.hidden = false;
      helper.textContent = "เพิ่มขนาดหรือราคาที่แตกต่างกัน (ไม่บังคับ)";
      note.hidden = true;
      const addRow = (): void => {
        const row = document.createElement("div"); row.className = "variant-row"; row.innerHTML = `<input class="variant-code" maxlength="32" placeholder="SMALL" aria-label="รหัส variant" /><input class="variant-name" maxlength="160" placeholder="ชื่อ variant" aria-label="ชื่อ variant" /><input class="variant-price" inputmode="decimal" min="0" step="0.01" type="number" placeholder="ราคา" aria-label="ราคา variant" /><button class="icon-action danger variant-remove" type="button" aria-label="ลบ variant">×</button>`; row.querySelector("button")!.addEventListener("click", () => row.remove()); list.append(row);
      };
      addVariant.onclick = addRow;
    }

    function openProductDrawer(product?: ProductSummary): void {
      productEditId = product?.id ?? null;
      productDrawer.dataset.dirty = "false";
      document.querySelector<HTMLElement>("#product-drawer-eyebrow")!.textContent = product ? "Edit product" : "New product";
      document.querySelector<HTMLElement>("#product-drawer-title")!.textContent = product ? "แก้ไขสินค้า" : "เพิ่มสินค้า";
      document.querySelector<HTMLInputElement>("#product-name")!.value = product?.name ?? "";
      const sku = document.querySelector<HTMLInputElement>("#product-sku")!; sku.value = product?.sku ?? ""; sku.disabled = Boolean(product); sku.required = !product;
      document.querySelector<HTMLSelectElement>("#product-category")!.value = product?.categoryId ?? "";
      document.querySelector<HTMLTextAreaElement>("#product-description")!.value = product?.description ?? "";
      document.querySelector<HTMLInputElement>("#product-price")!.value = product ? String(product.basePriceMinor / 100) : "";
      document.querySelector<HTMLElement>("#product-form-error")!.hidden = true;
      renderVariantRows(product);
      renderChannelChecks(product);
      renderModifierChecks(product);
      productDrawer.showModal();
      window.setTimeout(() => document.querySelector<HTMLInputElement>("#product-name")?.focus(), 0);
    }

    function collectVariants(): Array<{ code: string; name: string; priceMinor: number }> | undefined {
      const formRows = [...document.querySelectorAll<HTMLElement>("#variant-list .variant-row:not(.variant-row-readonly)")];
      if (!formRows.length) return undefined;
      return formRows.map((row, index) => { const code = row.querySelector<HTMLInputElement>(".variant-code")?.value.trim() ?? ""; const name = row.querySelector<HTMLInputElement>(".variant-name")?.value.trim() ?? ""; const price = Number(row.querySelector<HTMLInputElement>(".variant-price")?.value ?? ""); return { code: code || `VARIANT_${index + 1}`, name: name || `Variant ${index + 1}`, priceMinor: Math.round(price * 100) }; });
    }

    async function saveProduct(event: SubmitEvent): Promise<void> {
      event.preventDefault();
      if (!productForm.reportValidity()) return;
      const submit = document.querySelector<HTMLButtonElement>("#product-submit")!;
      const formError = document.querySelector<HTMLElement>("#product-form-error")!;
      submit.disabled = true; formError.hidden = true;
      const name = document.querySelector<HTMLInputElement>("#product-name")!.value.trim();
      const price = Number(document.querySelector<HTMLInputElement>("#product-price")!.value);
      if (!Number.isFinite(price) || price < 0) { formError.textContent = "กรุณาระบุราคาที่ถูกต้อง"; formError.hidden = false; submit.disabled = false; return; }
      const categoryId = document.querySelector<HTMLSelectElement>("#product-category")!.value;
      try {
        let productId = productEditId;
        if (productEditId) {
          await api(`/api/catalog/products/${productEditId}?storeId=${encodeURIComponent(selectedStoreId)}`, { method: "PATCH", body: JSON.stringify({ categoryId: categoryId || null, name, description: document.querySelector<HTMLTextAreaElement>("#product-description")!.value.trim(), basePriceMinor: Math.round(price * 100) }) });
        } else {
          const variants = collectVariants();
          const result = await api<{ product: ProductSummary }>("/api/catalog/products", { method: "POST", body: JSON.stringify({ storeId: selectedStoreId, categoryId: categoryId || undefined, sku: document.querySelector<HTMLInputElement>("#product-sku")!.value.trim(), name, description: document.querySelector<HTMLTextAreaElement>("#product-description")!.value.trim(), basePriceMinor: Math.round(price * 100), ...(variants ? { variants } : {}) }) });
          productId = result.product.id;
        }
        if (!productId) throw new Error("ไม่พบรหัสสินค้า");
        const productBefore = catalog?.products.find((item) => item.id === productId);
        const channelUpdates = channelOptions.map(async (channel) => { const checked = document.querySelector<HTMLInputElement>(`[data-channel-check="${channel}"]`)!.checked; const current = productBefore ? getAvailability(productBefore, channel).isAvailable : true; if (checked !== current) await api(`/api/catalog/products/${productId}/availability`, { method: "PATCH", body: JSON.stringify({ storeId: selectedStoreId, channel, isAvailable: checked }) }); });
        await Promise.all(channelUpdates);
        const desiredGroups = new Set([...document.querySelectorAll<HTMLInputElement>("[data-modifier-check]:checked")].map((input) => input.dataset.modifierCheck!));
        const existingGroups = catalog?.productModifierGroups.filter((mapping) => mapping.productId === productId) ?? [];
        await Promise.all(existingGroups.filter((mapping) => !desiredGroups.has(mapping.modifierGroupId)).map((mapping) => api(`/api/catalog/product-modifier-groups?storeId=${encodeURIComponent(selectedStoreId)}&productId=${encodeURIComponent(productId!)}&modifierGroupId=${encodeURIComponent(mapping.modifierGroupId)}`, { method: "DELETE" })));
        await Promise.all([...desiredGroups].filter((groupId) => !existingGroups.some((mapping) => mapping.modifierGroupId === groupId)).map((modifierGroupId) => api("/api/catalog/product-modifier-groups", { method: "POST", body: JSON.stringify({ storeId: selectedStoreId, productId, modifierGroupId }) })));
        productDrawer.close();
        productForm.reset();
        highlightProductId = productId;
        await loadCatalog();
        setTab("products", true);
        showSuccess(productEditId ? "บันทึกการแก้ไขสินค้าแล้ว" : "เพิ่มสินค้าแล้ว");
      } catch (cause) {
        formError.textContent = friendlyErrorMessage(cause, "บันทึกสินค้าไม่สำเร็จ ข้อมูลที่กรอกไว้ยังอยู่");
        formError.hidden = false;
      } finally { submit.disabled = false; }
    }

    function openMenuItemDialog(menu: MenuSummary): void {
      const context = document.querySelector<HTMLElement>("#menu-item-context")!; context.textContent = `กำลังเพิ่มสินค้าในเมนู “${menu.name}”`;
      const menuForm = document.querySelector<HTMLFormElement>("#menu-item-form")!; menuForm.dataset.menuId = menu.id;
      const productSelect = document.querySelector<HTMLSelectElement>("#menu-item-product")!; productSelect.replaceChildren(); for (const product of catalog?.products.filter((item) => item.status === "ACTIVE") ?? []) productSelect.add(new Option(`${product.name} · ${product.sku}`, product.id));
      updateMenuItemVariants();
      document.querySelector<HTMLInputElement>("#menu-item-price")!.value = "";
      document.querySelector<HTMLElement>("#menu-item-form-error")!.hidden = true;
      openDialog("menu-item-dialog");
    }

    function updateMenuItemVariants(): void { const product = catalog?.products.find((item) => item.id === document.querySelector<HTMLSelectElement>("#menu-item-product")!.value); const select = document.querySelector<HTMLSelectElement>("#menu-item-variant")!; select.replaceChildren(new Option("ใช้ราคาหลัก", "")); for (const variant of product?.variants ?? []) select.add(new Option(`${variant.name} · ${money(variant.priceMinor, product?.currency ?? "THB")}`, variant.id)); }

    async function saveMenuItem(event: SubmitEvent): Promise<void> { event.preventDefault(); const form = document.querySelector<HTMLFormElement>("#menu-item-form")!; const productId = document.querySelector<HTMLSelectElement>("#menu-item-product")!.value; const variantId = document.querySelector<HTMLSelectElement>("#menu-item-variant")!.value; const rawPrice = document.querySelector<HTMLInputElement>("#menu-item-price")!.value; const formError = document.querySelector<HTMLElement>("#menu-item-form-error")!; try { await api("/api/catalog/menu-items", { method: "POST", body: JSON.stringify({ storeId: selectedStoreId, menuId: form.dataset.menuId, productId, ...(variantId ? { variantId } : {}), ...(rawPrice ? { priceOverrideMinor: Math.round(Number(rawPrice) * 100) } : {}) }) }); closeDialog("menu-item-dialog"); await loadCatalog(); showSuccess("เพิ่มสินค้าในเมนูแล้ว"); } catch (cause) { formError.textContent = friendlyErrorMessage(cause, "เพิ่มสินค้าในเมนูไม่สำเร็จ"); formError.hidden = false; } }

    async function saveCategory(event: SubmitEvent): Promise<void> { event.preventDefault(); const form = document.querySelector<HTMLFormElement>("#category-form")!; if (!form.reportValidity()) return; const formError = document.querySelector<HTMLElement>("#category-form-error")!; try { await api("/api/catalog/categories", { method: "POST", body: JSON.stringify({ storeId: selectedStoreId, name: document.querySelector<HTMLInputElement>("#category-name")!.value.trim(), code: document.querySelector<HTMLInputElement>("#category-code")!.value.trim() || undefined, parentId: document.querySelector<HTMLSelectElement>("#category-parent")!.value || undefined }) }); closeDialog("category-dialog"); form.reset(); await loadCatalog(); setTab("categories", true); showSuccess("เพิ่มหมวดหมู่แล้ว"); } catch (cause) { formError.textContent = friendlyErrorMessage(cause, "เพิ่มหมวดหมู่ไม่สำเร็จ"); formError.hidden = false; } }

    async function saveMenu(event: SubmitEvent): Promise<void> { event.preventDefault(); const form = document.querySelector<HTMLFormElement>("#menu-form")!; if (!form.reportValidity()) return; const formError = document.querySelector<HTMLElement>("#menu-form-error")!; try { await api("/api/catalog/menus", { method: "POST", body: JSON.stringify({ storeId: selectedStoreId, name: document.querySelector<HTMLInputElement>("#menu-name")!.value.trim(), code: document.querySelector<HTMLInputElement>("#menu-code")!.value.trim() || undefined, channel: document.querySelector<HTMLSelectElement>("#menu-channel")!.value }) }); closeDialog("menu-dialog"); form.reset(); await loadCatalog(); setTab("menus", true); showSuccess("เพิ่มเมนูแล้ว"); } catch (cause) { formError.textContent = friendlyErrorMessage(cause, "เพิ่มเมนูไม่สำเร็จ"); formError.hidden = false; } }

    async function saveModifier(event: SubmitEvent): Promise<void> { event.preventDefault(); const form = document.querySelector<HTMLFormElement>("#modifier-form")!; if (!form.reportValidity()) return; const formError = document.querySelector<HTMLElement>("#modifier-form-error")!; const lines = document.querySelector<HTMLTextAreaElement>("#modifier-items")!.value.split("\n").map((line) => line.trim()).filter(Boolean); const modifiers = lines.map((line, index) => { const [name, price = "0"] = line.split("|"); return { code: `OPTION_${index + 1}`, name: name?.trim() || `Option ${index + 1}`, priceDeltaMinor: Math.round((Number(price) || 0) * 100) }; }); try { await api("/api/catalog/modifier-groups", { method: "POST", body: JSON.stringify({ storeId: selectedStoreId, name: document.querySelector<HTMLInputElement>("#modifier-name")!.value.trim(), selectionType: document.querySelector<HTMLSelectElement>("#modifier-type")!.value, required: document.querySelector<HTMLInputElement>("#modifier-required")!.checked, modifiers }) }); closeDialog("modifier-dialog"); form.reset(); await loadCatalog(); setTab("modifiers", true); showSuccess("เพิ่มกลุ่มตัวเลือกแล้ว"); } catch (cause) { formError.textContent = friendlyErrorMessage(cause, "เพิ่มกลุ่มตัวเลือกไม่สำเร็จ"); formError.hidden = false; } }

    productForm.addEventListener("submit", (event) => void saveProduct(event));
    productForm.addEventListener("input", () => { productDrawer.dataset.dirty = "true"; });
    document.querySelector<HTMLSelectElement>("#menu-item-product")!.addEventListener("change", updateMenuItemVariants);
    document.querySelector<HTMLFormElement>("#menu-item-form")!.addEventListener("submit", (event) => void saveMenuItem(event));
    document.querySelector<HTMLFormElement>("#category-form")!.addEventListener("submit", (event) => void saveCategory(event));
    document.querySelector<HTMLFormElement>("#menu-form")!.addEventListener("submit", (event) => void saveMenu(event));
    document.querySelector<HTMLFormElement>("#modifier-form")!.addEventListener("submit", (event) => void saveModifier(event));
    document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]").forEach((button) => button.addEventListener("click", () => closeDialog(button.dataset.closeDialog!)));
    productDrawer.addEventListener("cancel", (event) => { if (productDrawer.dataset.dirty === "true" && !window.confirm("มีข้อมูลที่ยังไม่ได้บันทึก ต้องการปิดหรือไม่")) event.preventDefault(); });
    productDrawer.addEventListener("close", () => { productDrawer.dataset.dirty = "false"; productEditId = null; });
    document.querySelectorAll<HTMLButtonElement>(".catalog-tab").forEach((button) => button.addEventListener("click", () => setTab(button.dataset.tab as CatalogTab)));
    window.addEventListener("popstate", () => setTab(getTabFromUrl(), true));
    [productSearch, categoryFilter, statusFilter, availabilityFilter, channelFilter, sortFilter].forEach((control) => control.addEventListener("input", renderProducts));
    tableView.addEventListener("click", () => { viewMode = "table"; localStorage.setItem("aevo.catalog.view", viewMode); tableView.classList.add("is-active"); gridView.classList.remove("is-active"); tableView.setAttribute("aria-pressed", "true"); gridView.setAttribute("aria-pressed", "false"); renderProducts(); });
    gridView.addEventListener("click", () => { viewMode = "grid"; localStorage.setItem("aevo.catalog.view", viewMode); gridView.classList.add("is-active"); tableView.classList.remove("is-active"); gridView.setAttribute("aria-pressed", "true"); tableView.setAttribute("aria-pressed", "false"); renderProducts(); });
    refresh.addEventListener("click", () => void loadCatalog());
    document.querySelector<HTMLButtonElement>("#add-category")!.addEventListener("click", () => openDialog("category-dialog"));
    document.querySelector<HTMLButtonElement>("#add-menu")!.addEventListener("click", () => openDialog("menu-dialog"));
    document.querySelector<HTMLButtonElement>("#add-modifier")!.addEventListener("click", () => openDialog("modifier-dialog"));

    async function initialise(): Promise<void> {
      const { user, stores: authorizedStores } = await loadStaffContext();
      stores = authorizedStores;
      const store = findSelectedStore(stores, requestedStoreId);
      if (!store) { window.location.assign("/staff"); return; }
      selectedStoreId = store.id;
      sessionStorage.setItem("aevo.selectedStoreId", selectedStoreId);
      document.querySelector<HTMLElement>("#store-summary")!.textContent = `${store.name} · ${store.code} · จัดการข้อมูลแยกตามสาขา`;
      initStaffShell({ user, stores, selectedStoreId, onStoreChange: async (nextStoreId) => { selectedStoreId = nextStoreId; catalog = null; const nextStore = stores.find((item) => item.id === nextStoreId); if (!nextStore) return; history.replaceState(null, "", storeUrl("/staff/catalog", nextStoreId, { tab: currentTab })); document.querySelector<HTMLElement>("#store-summary")!.textContent = `${nextStore.name} · ${nextStore.code} · จัดการข้อมูลแยกตามสาขา`; setLoading(true); await loadCatalog(); } });
      setTab(currentTab, true);
      await loadCatalog();
    }

    try { await initialise(); } catch (cause) { if (cause instanceof ApiError && cause.code === "UNAUTHORIZED") window.location.assign("/login"); else showError(cause, "โหลด Catalog ไม่สำเร็จ กรุณาลองใหม่"); }
  </script>

