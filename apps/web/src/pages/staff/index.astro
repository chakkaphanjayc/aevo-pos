---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Staff">
  <div class="shell">
    <header class="topbar">
      <div class="brand"><span class="brand-mark">A</span> Aevo Staff</div>
      <div class="header-actions"><span class="status">Online</span><button id="logout" class="button secondary">ออกจากระบบ</button></div>
    </header>
    <main class="page">
      <p class="eyebrow">Workspace</p>
      <h1 id="welcome">กำลังโหลดข้อมูล…</h1>
      <p class="lede">เลือกสาขาที่คุณได้รับอนุญาต ระบบจะใช้บริบทนี้กับทุกคำขอและตรวจซ้ำที่ server</p>
      <p class="error" id="error" role="alert" hidden></p>
      <section class="store-grid" id="stores" aria-live="polite"></section>
    </main>
  </div>
  <template id="store-card">
    <article class="card store-card">
      <div><p class="store-code"></p><h2></h2><p class="muted timezone"></p></div>
      <button class="button store-select" type="button">เข้าสู่ workspace</button>
    </article>
  </template>
  <script>
    import { api, ApiError } from "../../lib/api";
    import type { SessionPrincipal, StoreSummary } from "@aevo/contracts";
    const error = document.querySelector<HTMLParagraphElement>("#error")!;
    try {
      const [{ user }, { stores }] = await Promise.all([
        api<{ user: SessionPrincipal }>("/api/auth/me"), api<{ stores: StoreSummary[] }>("/api/stores")
      ]);
      document.querySelector("#welcome")!.textContent = `สวัสดี ${user.displayName || user.email}`;
      const list = document.querySelector<HTMLElement>("#stores")!;
      const template = document.querySelector<HTMLTemplateElement>("#store-card")!;
      for (const store of stores) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        node.querySelector("h2")!.textContent = store.name;
        node.querySelector(".store-code")!.textContent = store.code;
        node.querySelector(".timezone")!.textContent = store.timezone;
        node.querySelector<HTMLButtonElement>(".store-select")!.addEventListener("click", () => {
          sessionStorage.setItem("aevo.selectedStoreId", store.id);
          window.location.assign(`/staff/workspace?store=${encodeURIComponent(store.id)}`);
        });
        list.append(node);
      }
      if (!stores.length) list.textContent = "ยังไม่มีสาขาที่บัญชีนี้เข้าถึงได้";
    } catch (cause) {
      if (cause instanceof ApiError && cause.code === "UNAUTHORIZED") window.location.assign("/login");
      else { error.textContent = cause instanceof Error ? cause.message : "โหลดข้อมูลไม่สำเร็จ"; error.hidden = false; }
    }
    document.querySelector("#logout")!.addEventListener("click", async () => {
      await api("/api/auth/logout", { method: "POST" }).catch(() => undefined); window.location.assign("/login");
    });
  </script>
  <style>
    .header-actions { display: flex; align-items: center; gap: 16px; }
    .store-grid { margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    .store-card { min-height: 190px; padding: 22px; display: flex; flex-direction: column; justify-content: space-between; }
    .store-card h2 { margin: 4px 0; }
    .store-code { margin: 0; font-size: .76rem; font-weight: 800; color: var(--brand); letter-spacing: .12em; }
    @media (max-width: 520px) { .status { display: none; } }
  </style>
</BaseLayout>
