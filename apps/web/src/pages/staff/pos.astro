---
import StaffShell from "../../components/staff/StaffShell.astro";
---
<StaffShell title="POS" active="pos" fullHeight>
  <div slot="top-actions" class="pos-top-actions">
    <button class="pos-top-action" id="shift-btn" type="button" title="กะเงินสดในลิ้นชัก">
      <span aria-hidden="true">💵</span> <span id="shift-status-text">ตรวจกะ</span>
    </button>
    <button class="pos-top-action" id="held-orders-btn" type="button" title="ออเดอร์ที่พัก" aria-label="ออเดอร์ที่พัก"><span aria-hidden="true">▤</span><span class="held-badge" id="held-badge" hidden>0</span></button>
    <button class="outbox-badge" id="outbox-badge" type="button" hidden title="กดเพื่อซิงค์ข้อมูล">รอซิงค์ 0</button>
  </div>

  <div class="pos-shell">
    <div class="pos-body">
      <nav class="pos-categories" id="categories" aria-label="หมวดหมู่">
        <button class="pos-cat-btn active" data-category="all" type="button">ทั้งหมด</button>
      </nav>

      <section class="pos-products-area">
        <div class="pos-products-toolbar">
          <div><p class="pos-eyebrow">Point of sale</p><h1>เลือกสินค้า</h1><span class="pos-product-count" id="pos-product-count">กำลังโหลดเมนู…</span></div>
          <label class="pos-search"><span class="sr-only">ค้นหาสินค้า</span><span aria-hidden="true">⌕</span><input id="pos-search" type="search" placeholder="ค้นหาสินค้า…" autocomplete="off" /></label>
        </div>
        <main class="pos-products" id="products" aria-label="สินค้า"><p class="pos-loading">กำลังโหลดเมนู…</p></main>
      </section>

      <aside class="pos-cart" id="cart-panel">
        <div class="pos-cart-header" id="cart-header">
          <div><span class="pos-eyebrow">Current order</span><h2>ตะกร้า</h2></div>
          <div class="pos-cart-header-actions"><span class="pos-cart-count" id="cart-count">0</span><button class="pos-cart-clear" id="clear-cart" type="button" aria-label="ล้างตะกร้า">ล้าง</button></div>
        </div>
        <div class="pos-cart-items" id="cart-items">
          <div class="pos-cart-empty"><span class="pos-cart-empty-icon">＋</span><strong>ยังไม่มีสินค้า</strong><p>แตะสินค้าจากเมนูเพื่อเริ่มออเดอร์</p></div>
        </div>
        <div class="pos-cart-footer" id="cart-footer">
          <span class="pos-footer-label">รูปแบบการรับสินค้า</span>
          <div class="pos-fulfillment">
            <button class="pos-fulfill-btn active" data-type="TAKEAWAY" type="button" id="ft-takeaway">ซื้อกลับ</button>
            <button class="pos-fulfill-btn" data-type="DINE_IN" type="button" id="ft-dinein">ทานที่ร้าน</button>
          </div>
          <label class="pos-customer-row"><span>ชื่อลูกค้า <small>ไม่จำเป็น</small></span><input class="pos-input" type="text" id="customer-name" placeholder="เช่น คุณเมย์" maxlength="160" autocomplete="off" /></label>
          <div class="pos-totals">
            <div class="pos-total-line"><span>ยอดสินค้า</span><strong id="cart-subtotal">฿0.00</strong></div>
            <div class="pos-total-line pos-total-line-final"><span>ยอดชำระ</span><strong id="cart-total">฿0.00</strong></div>
          </div>
          <div class="pos-actions">
            <button class="pos-action-btn pos-hold-btn" id="hold-btn" type="button" disabled>พักออเดอร์</button>
            <button class="pos-action-btn pos-pay-btn" id="pay-btn" type="button" disabled>ชำระเงินสด</button>
          </div>
        </div>
      </aside>
    </div>

    <div class="pos-mobile-bar" id="mobile-bar" hidden>
      <div class="pos-mobile-bar-info">
        <span id="mobile-count">0 รายการ</span>
        <strong id="mobile-total">฿0.00</strong>
      </div>
      <button class="pos-action-btn pos-pay-btn pos-mobile-pay" id="mobile-pay-btn" type="button">ดูตะกร้า</button>
    </div>
  </div>

  <!-- Modifier modal -->
  <dialog class="pos-modal" id="modifier-modal">
    <div class="pos-modal-content">
      <div class="pos-modal-header">
        <h3 id="modifier-product-name">เลือก Modifier</h3>
        <button class="pos-modal-close" id="modifier-close" type="button" aria-label="ปิด">✕</button>
      </div>
      <div class="pos-modal-body" id="modifier-body"></div>
      <div class="pos-modal-footer">
        <div class="pos-modifier-price" id="modifier-price">฿0.00</div>
        <button class="pos-action-btn pos-pay-btn" id="modifier-add" type="button">เพิ่มลงตะกร้า</button>
      </div>
    </div>
  </dialog>

  <!-- Cash payment modal -->
  <dialog class="pos-modal" id="cash-modal">
    <div class="pos-modal-content">
      <div class="pos-modal-header">
        <h3>รับเงินสด</h3>
        <button class="pos-modal-close" id="cash-close" type="button" aria-label="ปิด">✕</button>
      </div>
      <div class="pos-modal-body">
        <div class="pos-cash-amount">
          <label>ยอดที่ต้องชำระ</label>
          <div class="pos-cash-total" id="cash-total">฿0.00</div>
        </div>
        <div class="pos-cash-input-row">
          <label for="cash-received">รับเงิน</label>
          <input class="pos-cash-input" type="number" id="cash-received" min="0" step="1" inputmode="decimal" />
        </div>
        <div class="pos-quick-amounts" id="quick-amounts"></div>
        <div class="pos-cash-change">
          <label>เงินทอน</label>
          <div class="pos-change-amount" id="cash-change">฿0.00</div>
        </div>
      </div>
      <div class="pos-modal-footer">
        <button class="pos-action-btn pos-pay-btn pos-confirm-pay" id="confirm-pay" type="button" disabled>ยืนยันการชำระเงิน</button>
      </div>
    </div>
  </dialog>

  <!-- Receipt modal -->
  <dialog class="pos-modal" id="receipt-modal">
    <div class="pos-modal-content pos-receipt-content">
      <div class="pos-receipt" id="receipt-body"></div>
      <div class="pos-modal-footer pos-receipt-footer">
        <button class="pos-action-btn pos-hold-btn" id="receipt-print" type="button">🖨️ พิมพ์</button>
        <button class="pos-action-btn pos-pay-btn" id="receipt-close" type="button">ออเดอร์ใหม่</button>
      </div>
    </div>
  </dialog>

  <!-- Held orders modal -->
  <dialog class="pos-modal" id="held-modal">
    <div class="pos-modal-content">
      <div class="pos-modal-header">
        <h3>ออเดอร์ที่พัก (Draft)</h3>
        <button class="pos-modal-close" id="held-close" type="button" aria-label="ปิด">✕</button>
      </div>
      <div class="pos-modal-body" id="held-body">
        <p class="pos-cart-empty">ไม่มีออเดอร์ที่พัก</p>
      </div>
    </div>
  </dialog>

  <!-- Cash Shift modal -->
  <dialog class="pos-modal" id="shift-modal">
    <div class="pos-modal-content">
      <div class="pos-modal-header">
        <h3 id="shift-modal-title">กะเงินสดในลิ้นชัก</h3>
        <button class="pos-modal-close" id="shift-close" type="button" aria-label="ปิด">✕</button>
      </div>
      <div class="pos-modal-body" id="shift-body">
        <p class="pos-cart-empty">กำลังโหลดข้อมูลกะ…</p>
      </div>
    </div>
  </dialog>

  <!-- Error toast -->
  <div class="pos-toast" id="toast" hidden role="alert"></div>

  <script>
    import { api, apiWithIdempotency, ApiError } from "../../lib/api";
    import { friendlyErrorMessage, initStaffShell, storeUrl } from "../../lib/staff-ui";
    import { cacheCatalog, getCachedCatalog } from "../../lib/idb-cache";
    import {
      queueOfflineCashOrder,
      syncOutbox,
      getPendingOutboxEntries,
      subscribeOutboxChanges
    } from "../../lib/outbox";
    import type {
      CatalogSnapshot,
      CreateOrderInput,
      OrderSummary,
      OrderListItem,
      SessionPrincipal,
      StoreSummary,
      ProductSummary,
      ModifierGroupSummary
    } from "@aevo/contracts";
    import {
      createEmptyCart,
      addItem,
      removeItem,
      updateQuantity,
      clearCart,
      setFulfillmentType,
      setCustomer,
      cartTotals,
      lineTotal,
      formatMoney,
      buildProductModifierGroupMap,
      effectivePrice,
      getProductModifierGroups,
      type CartItem,
      type CartItemModifier
    } from "../../lib/pos-store";

    /* ---------------------------------------------------------------- */
    /* DOM refs                                                         */
    /* ---------------------------------------------------------------- */
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const categoriesNav = $<HTMLElement>("categories");
    const productsGrid = $<HTMLElement>("products");
    const cartItemsEl = $<HTMLElement>("cart-items");
    const cartCountEl = $<HTMLElement>("cart-count");
    const cartTotalEl = $<HTMLElement>("cart-total");
    const cartSubtotalEl = $<HTMLElement>("cart-subtotal");
    const mobileBar = $<HTMLElement>("mobile-bar");
    const mobileCount = $<HTMLElement>("mobile-count");
    const mobileTotal = $<HTMLElement>("mobile-total");
    const payBtn = $<HTMLButtonElement>("pay-btn");
    const holdBtn = $<HTMLButtonElement>("hold-btn");
    const mobilePayBtn = $<HTMLButtonElement>("mobile-pay-btn");
    const cartPanel = $<HTMLElement>("cart-panel");
    const storeNameEl = $<HTMLElement>("store-name");
    const productSearch = $<HTMLInputElement>("pos-search");
    const productCountEl = $<HTMLElement>("pos-product-count");
    const clearCartBtn = $<HTMLButtonElement>("clear-cart");
    const toast = $<HTMLElement>("toast");
    const modifierModal = $<HTMLDialogElement>("modifier-modal");
    const cashModal = $<HTMLDialogElement>("cash-modal");
    const receiptModal = $<HTMLDialogElement>("receipt-modal");
    const heldModal = $<HTMLDialogElement>("held-modal");

    /* ---------------------------------------------------------------- */
    /* State                                                            */
    /* ---------------------------------------------------------------- */
    let cart = createEmptyCart();
    let catalog: CatalogSnapshot | null = null;
    let productModifierGroupMap = new Map<string, string[]>();
    let selectedCategory = "all";
    let searchQuery = "";
    let selectedStoreId = "";
    let storeName = "";
    let principal: SessionPrincipal | null = null;
    let catalogLoadVersion = 0;

    async function loadCatalogForStore(store: StoreSummary): Promise<void> {
      const loadVersion = ++catalogLoadVersion;
      selectedStoreId = store.id;
      storeName = store.name;
      storeNameEl.textContent = store.name;
      catalog = null;
      productModifierGroupMap = new Map();
      productsGrid.innerHTML = '<p class="pos-loading">กำลังโหลดเมนู…</p>';
      categoriesNav.innerHTML = '<button class="pos-cat-btn active" data-category="all" type="button">ทั้งหมด</button>';

      const catalogRequest = api<CatalogSnapshot>(`/api/catalog?storeId=${encodeURIComponent(store.id)}`);
      const cachedRequest = getCachedCatalog(store.id).catch(() => null);
      const cached = await cachedRequest;
      if (loadVersion !== catalogLoadVersion) {
        void catalogRequest.catch(() => undefined);
        return;
      }
      if (cached) {
        catalog = cached;
        productModifierGroupMap = buildProductModifierGroupMap(cached.productModifierGroups);
        renderCategories();
        renderProducts();
        showToast("กำลังอัปเดตเมนู…", false);
      }

      try {
        const freshCatalog = await catalogRequest;
        if (loadVersion !== catalogLoadVersion) return;
        catalog = freshCatalog;
        productModifierGroupMap = buildProductModifierGroupMap(freshCatalog.productModifierGroups);
        void cacheCatalog(store.id, freshCatalog).catch(() => undefined);
      } catch (cause) {
        if (!cached) {
          if (cause instanceof ApiError && cause.code === "UNAUTHORIZED") throw cause;
          const message = friendlyErrorMessage(cause, "โหลดเมนูไม่สำเร็จ กรุณาลองใหม่");
          renderCatalogError(message, store);
          showToast(message, true);
          return;
        }
        showToast("อัปเดตเมนูไม่ได้ ใช้ข้อมูลล่าสุดที่บันทึกไว้", true);
      }
      if (!catalog) return;
      productModifierGroupMap = buildProductModifierGroupMap(catalog.productModifierGroups);
      renderCategories();
      renderProducts();
    }

    /* ---------------------------------------------------------------- */
    /* Init                                                             */
    /* ---------------------------------------------------------------- */
    const params = new URLSearchParams(window.location.search);
    selectedStoreId = params.get("store") || sessionStorage.getItem("aevo.selectedStoreId") || "";
    if (!selectedStoreId) { window.location.assign("/staff"); }

    try {
      const [{ user }, { stores }] = await Promise.all([
        api<{ user: SessionPrincipal }>("/api/auth/me"),
        api<{ stores: StoreSummary[] }>("/api/stores")
      ]);
      principal = user;
      const store = stores.find((s) => s.id === selectedStoreId);
      if (!store) { window.location.assign("/staff"); throw new Error("store not found"); }
      sessionStorage.setItem("aevo.selectedStoreId", store.id);
      initStaffShell({
        user,
        stores,
        selectedStoreId,
        onStoreChange: async (nextStoreId) => {
          const nextStore = stores.find((item) => item.id === nextStoreId);
          if (!nextStore) return;
          cart = clearCart(cart);
          $<HTMLInputElement>("customer-name").value = "";
          selectedCategory = "all";
          searchQuery = "";
          productSearch.value = "";
          history.replaceState(null, "", storeUrl("/staff/pos", nextStoreId));
          renderCart();
          await loadCatalogForStore(nextStore);
          void refreshShiftStatus();
        }
      });
      await loadCatalogForStore(store);
      void refreshShiftStatus();
    } catch (cause) {
      if (cause instanceof ApiError && cause.code === "UNAUTHORIZED") window.location.assign("/login");
      else showToast(friendlyErrorMessage(cause, "โหลดข้อมูลไม่สำเร็จ กรุณาลองใหม่"), true);
    }

    /* ---------------------------------------------------------------- */
    /* Online / Offline & Outbox Sync                                   */
    /* ---------------------------------------------------------------- */
    const connectionStatusEl = $<HTMLElement>("connection-status");
    const outboxBadgeEl = $<HTMLButtonElement>("outbox-badge");

    function updateOnlineState() {
      const isOnline = navigator.onLine;
      if (isOnline) {
        connectionStatusEl.textContent = "Online";
        connectionStatusEl.className = "status online";
        syncOutbox().then(refreshOutboxBadge).catch(() => undefined);
      } else {
        connectionStatusEl.textContent = "Offline";
        connectionStatusEl.className = "status offline";
      }
    }

    async function refreshOutboxBadge() {
      try {
        const pending = await getPendingOutboxEntries();
        if (pending.length > 0) {
          outboxBadgeEl.textContent = `⏳ ${pending.length} รอซิงค์`;
          outboxBadgeEl.hidden = false;
        } else {
          outboxBadgeEl.hidden = true;
        }
      } catch {
        // Outbox query failed (e.g. private browsing IDB restriction)
      }
    }

    window.addEventListener("online", () => {
      updateOnlineState();
      showToast("เชื่อมต่ออินเทอร์เน็ตแล้ว กำลังซิงค์ข้อมูล…", false);
    });
    window.addEventListener("offline", () => {
      updateOnlineState();
      showToast("ขาดการเชื่อมต่ออินเทอร์เน็ต เข้าสู่โหมดออฟไลน์", true);
    });
    outboxBadgeEl.addEventListener("click", async () => {
      if (!navigator.onLine) {
        showToast("อุปกรณ์ยังออฟไลน์อยู่ ไม่สามารถซิงค์ได้", true);
        return;
      }
      connectionStatusEl.className = "status syncing";
      connectionStatusEl.textContent = "Syncing…";
      const { synced, failed } = await syncOutbox();
      updateOnlineState();
      await refreshOutboxBadge();
      if (failed > 0) showToast(`ซิงค์สำเร็จ ${synced} รายการ, มีปัญหา ${failed} รายการ`, true);
      else showToast(`ซิงค์เรียบร้อย ${synced} รายการ`, false);
    });

    subscribeOutboxChanges(refreshOutboxBadge);
    updateOnlineState();
    refreshOutboxBadge();
    setInterval(() => {
      if (navigator.onLine) syncOutbox().then(refreshOutboxBadge).catch(() => undefined);
    }, 30000);

    /* ---------------------------------------------------------------- */
    /* Render: Categories                                               */
    /* ---------------------------------------------------------------- */
    function renderCategories() {
      if (!catalog) return;
      categoriesNav.innerHTML = "";
      const allBtn = document.createElement("button");
      allBtn.className = "pos-cat-btn active";
      allBtn.dataset.category = "all";
      allBtn.type = "button";
      allBtn.textContent = "ทั้งหมด";
      allBtn.addEventListener("click", () => selectCategory("all"));
      categoriesNav.appendChild(allBtn);

      for (const cat of catalog.categories.filter((c) => c.status === "ACTIVE")) {
        const btn = document.createElement("button");
        btn.className = "pos-cat-btn";
        btn.dataset.category = cat.id;
        btn.type = "button";
        btn.textContent = cat.name;
        btn.addEventListener("click", () => selectCategory(cat.id));
        categoriesNav.appendChild(btn);
      }
    }

    function selectCategory(catId: string) {
      selectedCategory = catId;
      categoriesNav.querySelectorAll(".pos-cat-btn").forEach((btn) => {
        btn.classList.toggle("active", (btn as HTMLElement).dataset.category === catId);
      });
      renderProducts();
    }

    productSearch.addEventListener("input", () => {
      searchQuery = productSearch.value.trim().toLowerCase();
      renderProducts();
    });

    /* ---------------------------------------------------------------- */
    /* Render: Products                                                 */
    /* ---------------------------------------------------------------- */
    function renderProducts() {
      if (!catalog) return;
      const products = catalog.products
        .filter((p) => p.status === "ACTIVE")
        .filter((p) => p.availability.find((entry) => entry.channel === "POS")?.isAvailable !== false)
        .filter((p) => !searchQuery || `${p.name} ${p.sku}`.toLowerCase().includes(searchQuery))
        .filter((p) => selectedCategory === "all" || p.categoryId === selectedCategory);

      productsGrid.innerHTML = "";
      productCountEl.textContent = `${products.length} รายการ`;
      if (products.length === 0) {
        productsGrid.innerHTML = `<div class="pos-empty-products"><span class="pos-empty-products-icon">⌕</span><strong>${searchQuery ? "ไม่พบสินค้าที่ค้นหา" : "ไม่มีสินค้าในหมวดนี้"}</strong><p>${searchQuery ? "ลองค้นหาด้วยชื่อหรือ SKU อื่น" : "เลือกหมวดหมู่อื่นหรือเพิ่มสินค้าจาก Catalog"}</p><a href="${selectedStoreId ? `/staff/catalog?store=${encodeURIComponent(selectedStoreId)}&tab=products` : "/staff/catalog"}">ไปที่ Catalog →</a></div>`;
        return;
      }

      for (const product of products) {
        const card = document.createElement("button");
        card.className = "pos-product-card";
        card.type = "button";
        const posAvailability = product.availability.find((a) => a.channel === "POS");
        const soldOut = posAvailability?.soldOut ?? false;
        if (soldOut) card.classList.add("sold-out");
        card.innerHTML = `
          <span class="pos-product-card-top"><span class="pos-product-thumb" aria-hidden="true">${escapeHtml(product.name.slice(0, 1))}</span>${soldOut ? '<span class="pos-sold-out-badge">หมด</span>' : product.variants.length > 1 ? '<span class="pos-variant-badge">หลายขนาด</span>' : ""}</span>
          <span class="pos-product-name">${escapeHtml(product.name)}</span>
          <span class="pos-product-meta"><span class="pos-product-price">${formatMoney(product.basePriceMinor, product.currency)}</span>${product.variants.length > 1 ? `<span>${product.variants.length} variants</span>` : ""}</span>
        `;
        if (!soldOut) {
          card.addEventListener("click", () => onProductTap(product));
        }
        productsGrid.appendChild(card);
      }
    }

    /* ---------------------------------------------------------------- */
    /* Product tap → modifiers or direct add                            */
    /* ---------------------------------------------------------------- */
    function onProductTap(product: ProductSummary) {
      if (!catalog) return;
      const groups = getProductModifierGroups(product.id, productModifierGroupMap, catalog.modifierGroups);
      const hasVariants = product.variants.length > 1;

      if (groups.length === 0 && !hasVariants) {
        // Direct add — no modifiers, single/no variant
        const variant = product.variants[0];
        const item: CartItem = {
          id: crypto.randomUUID(),
          productId: product.id,
          variantId: variant?.id,
          productName: product.name,
          variantName: variant && variant.name !== "Standard" ? variant.name : undefined,
          modifiers: [],
          unitPriceMinor: effectivePrice(product, variant),
          quantity: 1,
          note: ""
        };
        cart = addItem(cart, item);
        renderCart();
        return;
      }

      // Open modifier modal
      openModifierModal(product, groups);
    }

    /* ---------------------------------------------------------------- */
    /* Modifier modal                                                   */
    /* ---------------------------------------------------------------- */
    let pendingModProduct: ProductSummary | null = null;

    function openModifierModal(
      product: ProductSummary,
      groups: ModifierGroupSummary[]
    ) {
      if (!catalog) return;
      pendingModProduct = product;
      $<HTMLElement>("modifier-product-name").textContent = product.name;
      const body = $<HTMLElement>("modifier-body");
      body.innerHTML = "";

      // Variant selection (if multiple)
      if (product.variants.length > 1) {
        const section = document.createElement("div");
        section.className = "pos-mod-section";
        section.innerHTML = `<h4 class="pos-mod-group-name">ตัวเลือก</h4>`;
        const grid = document.createElement("div");
        grid.className = "pos-mod-options";
        for (const v of product.variants.filter((vv) => vv.status === "ACTIVE")) {
          const label = document.createElement("label");
          label.className = "pos-mod-option";
          label.innerHTML = `
            <input type="radio" name="pos-variant" value="${v.id}" data-price="${v.priceMinor}" ${v === product.variants[0] ? "checked" : ""} />
            <span class="pos-mod-option-label">${escapeHtml(v.name)}</span>
            <span class="pos-mod-option-price">${formatMoney(v.priceMinor)}</span>
          `;
          grid.appendChild(label);
        }
        section.appendChild(grid);
        body.appendChild(section);
      }

      // Modifier groups
      for (const group of groups) {
        const section = document.createElement("div");
        section.className = "pos-mod-section";
        const required = group.required ? ' <span class="pos-required">*จำเป็น</span>' : "";
        section.innerHTML = `<h4 class="pos-mod-group-name">${escapeHtml(group.name)}${required}</h4>`;
        const grid = document.createElement("div");
        grid.className = "pos-mod-options";
        const inputType = group.selectionType === "SINGLE" ? "radio" : "checkbox";
        for (const mod of group.modifiers.filter((m) => m.status === "ACTIVE")) {
          const label = document.createElement("label");
          label.className = "pos-mod-option";
          const delta = mod.priceDeltaMinor !== 0 ? ` (+${formatMoney(mod.priceDeltaMinor)})` : "";
          label.innerHTML = `
            <input type="${inputType}" name="pos-mod-${group.id}" value="${mod.id}"
              data-group="${group.id}" data-delta="${mod.priceDeltaMinor}" data-name="${escapeHtml(mod.name)}" />
            <span class="pos-mod-option-label">${escapeHtml(mod.name)}</span>
            <span class="pos-mod-option-price">${delta}</span>
          `;
          grid.appendChild(label);
        }
        section.appendChild(grid);
        body.appendChild(section);
      }

      updateModifierPrice();
      body.addEventListener("change", updateModifierPrice);
      modifierModal.showModal();
    }

    function updateModifierPrice() {
      if (!pendingModProduct || !catalog) return;
      const body = $<HTMLElement>("modifier-body");
      // Get selected variant price
      const variantRadio = body.querySelector<HTMLInputElement>('input[name="pos-variant"]:checked');
      const basePrice = variantRadio ? Number(variantRadio.dataset.price) : pendingModProduct.basePriceMinor;
      // Sum modifier deltas
      const checked = body.querySelectorAll<HTMLInputElement>("input[data-delta]:checked");
      let modDelta = 0;
      checked.forEach((el) => { modDelta += Number(el.dataset.delta || 0); });
      $<HTMLElement>("modifier-price").textContent = formatMoney(basePrice + modDelta);
    }

    $<HTMLButtonElement>("modifier-add").addEventListener("click", () => {
      if (!pendingModProduct || !catalog) return;
      const body = $<HTMLElement>("modifier-body");
      // Validate required groups
      const groups = getProductModifierGroups(pendingModProduct.id, productModifierGroupMap, catalog.modifierGroups);
      for (const group of groups) {
        if (group.required) {
          const checked = body.querySelectorAll<HTMLInputElement>(`input[data-group="${group.id}"]:checked`);
          if (checked.length < group.minSelections) {
            showToast(`กรุณาเลือก ${group.name} อย่างน้อย ${group.minSelections} รายการ`, true);
            return;
          }
        }
      }
      // Build cart item
      const variantRadio = body.querySelector<HTMLInputElement>('input[name="pos-variant"]:checked');
      const variant = variantRadio ? pendingModProduct.variants.find((v) => v.id === variantRadio.value) : pendingModProduct.variants[0];
      const selectedMods: CartItemModifier[] = [];
      body.querySelectorAll<HTMLInputElement>("input[data-delta]:checked").forEach((el) => {
        selectedMods.push({
          modifierId: el.value,
          modifierGroupId: el.dataset.group || "",
          name: el.dataset.name || "",
          priceDeltaMinor: Number(el.dataset.delta || 0)
        });
      });
      const item: CartItem = {
        id: crypto.randomUUID(),
        productId: pendingModProduct.id,
        variantId: variant?.id,
        productName: pendingModProduct.name,
        variantName: variant && variant.name !== "Standard" ? variant.name : undefined,
        modifiers: selectedMods,
        unitPriceMinor: effectivePrice(pendingModProduct, variant),
        quantity: 1,
        note: ""
      };
      cart = addItem(cart, item);
      renderCart();
      modifierModal.close();
      pendingModProduct = null;
    });

    $<HTMLButtonElement>("modifier-close").addEventListener("click", () => {
      modifierModal.close();
      pendingModProduct = null;
    });

    /* ---------------------------------------------------------------- */
    /* Render: Cart                                                     */
    /* ---------------------------------------------------------------- */
    function renderCart() {
      const totals = cartTotals(cart);
      const itemCount = cart.items.reduce((sum, i) => sum + i.quantity, 0);
      cartCountEl.textContent = String(itemCount);
      cartSubtotalEl.textContent = formatMoney(totals.subtotalMinor);
      cartTotalEl.textContent = formatMoney(totals.totalMinor);
      payBtn.disabled = cart.items.length === 0;
      holdBtn.disabled = cart.items.length === 0;
      payBtn.textContent = cart.items.length > 0 ? `💰 ชำระเงินสด ${formatMoney(totals.totalMinor)}` : "💰 ชำระเงินสด";

      // Mobile bar
      mobileCount.textContent = `${itemCount} รายการ`;
      mobileTotal.textContent = formatMoney(totals.totalMinor);
      mobileBar.hidden = cart.items.length === 0;

      // Cart items
      cartItemsEl.innerHTML = "";
      if (cart.items.length === 0) {
        cartItemsEl.innerHTML = '<div class="pos-cart-empty"><span class="pos-cart-empty-icon">＋</span><strong>ยังไม่มีสินค้า</strong><p>แตะสินค้าจากเมนูเพื่อเริ่มออเดอร์</p></div>';
        return;
      }
      for (const item of cart.items) {
        const row = document.createElement("div");
        row.className = "pos-cart-item";
        const modLines = item.modifiers.length > 0
          ? `<div class="pos-cart-item-mods">${item.modifiers.map((m) =>
              `<span class="pos-cart-mod">+ ${escapeHtml(m.name)}${m.priceDeltaMinor ? ` ${formatMoney(m.priceDeltaMinor)}` : ""}</span>`
            ).join("")}</div>`
          : "";
        const variantLabel = item.variantName ? ` (${escapeHtml(item.variantName)})` : "";
        row.innerHTML = `
          <div class="pos-cart-item-info">
            <span class="pos-cart-item-name">${escapeHtml(item.productName)}${variantLabel}</span>
            ${modLines}
          </div>
          <div class="pos-cart-item-controls">
            <div class="pos-qty">
              <button class="pos-qty-btn" data-action="dec" data-id="${item.id}" type="button">−</button>
              <span class="pos-qty-value">${item.quantity}</span>
              <button class="pos-qty-btn" data-action="inc" data-id="${item.id}" type="button">+</button>
            </div>
            <span class="pos-cart-item-total">${formatMoney(lineTotal(item))}</span>
            <button class="pos-remove-btn" data-id="${item.id}" type="button" aria-label="ลบ">✕</button>
          </div>
        `;
        cartItemsEl.appendChild(row);
      }

      // Event delegation for qty buttons
      cartItemsEl.querySelectorAll<HTMLButtonElement>(".pos-qty-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.id!;
          const action = btn.dataset.action;
          const item = cart.items.find((i) => i.id === id);
          if (!item) return;
          cart = updateQuantity(cart, id, action === "inc" ? item.quantity + 1 : item.quantity - 1);
          renderCart();
        });
      });
      cartItemsEl.querySelectorAll<HTMLButtonElement>(".pos-remove-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          cart = removeItem(cart, btn.dataset.id!);
          renderCart();
        });
      });
    }

    /* ---------------------------------------------------------------- */
    /* Fulfillment type                                                 */
    /* ---------------------------------------------------------------- */
    $<HTMLButtonElement>("ft-takeaway").addEventListener("click", () => {
      cart = setFulfillmentType(cart, "TAKEAWAY");
      $<HTMLButtonElement>("ft-takeaway").classList.add("active");
      $<HTMLButtonElement>("ft-dinein").classList.remove("active");
    });
    $<HTMLButtonElement>("ft-dinein").addEventListener("click", () => {
      cart = setFulfillmentType(cart, "DINE_IN");
      $<HTMLButtonElement>("ft-dinein").classList.add("active");
      $<HTMLButtonElement>("ft-takeaway").classList.remove("active");
    });

    clearCartBtn.addEventListener("click", () => {
      if (cart.items.length === 0) return;
      if (!window.confirm("ล้างสินค้าทั้งหมดออกจากตะกร้าหรือไม่")) return;
      cart = clearCart(cart);
      $<HTMLInputElement>("customer-name").value = "";
      renderCart();
    });

    /* ---------------------------------------------------------------- */
    /* Cash payment                                                     */
    /* ---------------------------------------------------------------- */
    async function openCashModal() {
      if (!currentShift || currentShift.status !== "OPEN") {
        await refreshShiftStatus();
      }
      if (!currentShift || currentShift.status !== "OPEN") {
        showToast("กรุณาเปิดกะการขายก่อนรับชำระเงิน", true);
        renderShiftModal();
        shiftModal.showModal();
        return;
      }
      const totals = cartTotals(cart);
      $<HTMLElement>("cash-total").textContent = formatMoney(totals.totalMinor);
      const input = $<HTMLInputElement>("cash-received");
      input.value = String(totals.totalMinor / 100);
      updateCashChange();

      // Quick amounts
      const quickEl = $<HTMLElement>("quick-amounts");
      quickEl.innerHTML = "";
      const amount = totals.totalMinor / 100;
      const quicks = [
        Math.ceil(amount), // Exact
        ...[20, 50, 100, 500, 1000].filter((v) => v >= amount)
      ];
      const unique = [...new Set(quicks)].slice(0, 5);
      for (const q of unique) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "pos-quick-btn";
        btn.textContent = `฿${q.toLocaleString()}`;
        btn.addEventListener("click", () => {
          input.value = String(q);
          updateCashChange();
        });
        quickEl.appendChild(btn);
      }
      cashModal.showModal();
    }

    function updateCashChange() {
      const totals = cartTotals(cart);
      const received = Math.round((parseFloat($<HTMLInputElement>("cash-received").value) || 0) * 100);
      const change = received - totals.totalMinor;
      $<HTMLElement>("cash-change").textContent = formatMoney(Math.max(0, change));
      $<HTMLElement>("cash-change").classList.toggle("pos-negative", change < 0);
      $<HTMLButtonElement>("confirm-pay").disabled = change < 0;
    }

    $<HTMLInputElement>("cash-received").addEventListener("input", updateCashChange);
    payBtn.addEventListener("click", openCashModal);
    mobilePayBtn.addEventListener("click", () => {
      cartPanel.classList.toggle("expanded");
      mobilePayBtn.textContent = cartPanel.classList.contains("expanded") ? "ซ่อนตะกร้า" : "ดูตะกร้า";
    });
    $<HTMLButtonElement>("cash-close").addEventListener("click", () => cashModal.close());

    /* ---------------------------------------------------------------- */
    /* Checkout                                                         */
    /* ---------------------------------------------------------------- */
    $<HTMLButtonElement>("confirm-pay").addEventListener("click", async () => {
      if (cart.items.length === 0) return;
      const confirmBtn = $<HTMLButtonElement>("confirm-pay");
      confirmBtn.disabled = true;
      confirmBtn.textContent = "กำลังดำเนินการ…";

      try {
        const customerName = $<HTMLInputElement>("customer-name").value.trim();
        cart = setCustomer(cart, customerName, "");
        const totals = cartTotals(cart);
        const received = Math.round((parseFloat($<HTMLInputElement>("cash-received").value) || 0) * 100);

        const orderInput: CreateOrderInput = {
          storeId: selectedStoreId,
          channel: "POS",
          fulfillmentType: cart.fulfillmentType,
          ...(cart.customerName ? { customerName: cart.customerName } : {}),
          ...(cart.notes ? { notes: cart.notes } : {}),
          items: cart.items.map((item) => ({
            productId: item.productId,
            ...(item.variantId ? { variantId: item.variantId } : {}),
            ...(item.modifiers.length > 0 ? { modifierIds: item.modifiers.map((m) => m.modifierId) } : {}),
            quantity: item.quantity,
            ...(item.note ? { note: item.note } : {})
          }))
        };

        const executeOfflineCheckout = async () => {
          const offlineRes = await queueOfflineCashOrder(selectedStoreId, orderInput, totals.totalMinor);
          const syntheticOrder: OrderSummary = {
            id: offlineRes.temporaryOrderId,
            organizationId: "",
            storeId: selectedStoreId,
            orderNumber: offlineRes.temporaryOrderNumber,
            channel: "POS",
            fulfillmentType: cart.fulfillmentType,
            status: "CONFIRMED",
            paymentStatus: "PAID",
            totalMinor: totals.totalMinor,
            subtotalMinor: totals.subtotalMinor,
            discountMinor: 0,
            taxMinor: 0,
            currency: "THB",
            customerName: cart.customerName,
            items: cart.items.map((item, idx) => ({
              id: item.id,
              lineNumber: idx + 1,
              productId: item.productId,
              productName: item.productName,
              variantId: item.variantId,
              variantName: item.variantName,
              sku: "",
              unitPriceMinor: item.unitPriceMinor,
              quantity: item.quantity,
              subtotalMinor: lineTotal(item),
              note: item.note,
              modifiers: item.modifiers.map((m) => ({
                id: m.modifierId,
                modifierId: m.modifierId,
                modifierGroupId: m.modifierGroupId,
                name: m.name,
                priceDeltaMinor: m.priceDeltaMinor,
                quantity: 1
              }))
            })),
            createdAt: new Date().toISOString(),
            updatedAt: new Date().toISOString()
          };
          cashModal.close();
          showReceipt(syntheticOrder, received);
          cart = clearCart(cart);
          $<HTMLInputElement>("customer-name").value = "";
          renderCart();
          await refreshOutboxBadge();
          showToast(`บันทึกออฟไลน์แล้ว (${offlineRes.temporaryOrderNumber})`, false);
        };

        if (!navigator.onLine) {
          await executeOfflineCheckout();
          return;
        }

        try {
          // 1. Create order
          const { order } = await apiWithIdempotency<{ order: OrderSummary }>("/api/orders", "POST", orderInput);

          // 2. Record payment
          await apiWithIdempotency("/api/orders/" + order.id + "/payments", "POST", {
            storeId: selectedStoreId,
            method: "CASH",
            amountMinor: totals.totalMinor
          });

          // 3. Transition to CONFIRMED
          await apiWithIdempotency("/api/orders/" + order.id + "/transition", "POST", {
            storeId: selectedStoreId,
            toStatus: "CONFIRMED",
            expectedStatus: "PAID"
          });

          // Success → show receipt
          cashModal.close();
          showReceipt(order, received);
          cart = clearCart(cart);
          $<HTMLInputElement>("customer-name").value = "";
          renderCart();
        } catch (onlineErr) {
          if (onlineErr instanceof ApiError && onlineErr.status === 0) {
            // Mid-checkout connection drop: fallback to outbox
            await executeOfflineCheckout();
          } else {
            throw onlineErr;
          }
        }
      } catch (cause) {
        showToast(friendlyErrorMessage(cause, "ชำระเงินไม่สำเร็จ กรุณาตรวจสอบยอดแล้วลองใหม่"), true);
      } finally {
        confirmBtn.disabled = false;
        confirmBtn.textContent = "ยืนยันการชำระเงิน";
      }
    });

    /* ---------------------------------------------------------------- */
    /* Receipt                                                          */
    /* ---------------------------------------------------------------- */
    function showReceipt(order: OrderSummary, receivedMinor: number) {
      const change = receivedMinor - order.totalMinor;
      const typeLabel = order.fulfillmentType === "TAKEAWAY" ? "ซื้อกลับ" : order.fulfillmentType === "DINE_IN" ? "ทานที่ร้าน" : "PICKUP";
      const date = new Date(order.createdAt).toLocaleString("th-TH");
      let html = `
        <div class="pos-receipt-header">
          <div class="pos-receipt-store">${escapeHtml(storeName)}</div>
          <div class="pos-receipt-divider">═══════════════════</div>
        </div>
        <div class="pos-receipt-meta">
          <div>Order: <strong>${escapeHtml(order.orderNumber)}</strong></div>
          ${order.orderNumber.startsWith("OFFLINE-") ? '<div class="pos-receipt-offline-badge">⏳ ออฟไลน์ (รอเชื่อมต่อเพื่อซิงค์)</div>' : ""}
          <div>วันที่: ${date}</div>
          <div>แคชเชียร์: ${escapeHtml(principal?.email || "Staff")}</div>
          <div>ประเภท: ${typeLabel}</div>
          ${order.customerName ? `<div>ลูกค้า: ${escapeHtml(order.customerName)}</div>` : ""}
        </div>
        <div class="pos-receipt-divider">───────────────────</div>
        <div class="pos-receipt-items">
      `;
      for (const item of order.items) {
        const varLabel = item.variantName ? ` (${escapeHtml(item.variantName)})` : "";
        html += `<div class="pos-receipt-item">
          <span>${escapeHtml(item.productName)}${varLabel} × ${item.quantity}</span>
          <span>${formatMoney(item.subtotalMinor)}</span>
        </div>`;
        for (const mod of item.modifiers) {
          html += `<div class="pos-receipt-mod">  + ${escapeHtml(mod.name)}</div>`;
        }
      }
      html += `
        </div>
        <div class="pos-receipt-divider">───────────────────</div>
        <div class="pos-receipt-totals">
          <div><span>รวม</span><strong>${formatMoney(order.totalMinor)}</strong></div>
          <div><span>รับเงิน</span><span>${formatMoney(receivedMinor)}</span></div>
          <div class="pos-receipt-change"><span>เงินทอน</span><strong>${formatMoney(Math.max(0, change))}</strong></div>
        </div>
        <div class="pos-receipt-divider">═══════════════════</div>
        <div class="pos-receipt-footer">ขอบคุณที่ใช้บริการ</div>
      `;
      $<HTMLElement>("receipt-body").innerHTML = html;
      receiptModal.showModal();

      // Persist receipt in background to database
      if (!order.id.startsWith("offline-")) {
        api<{ receipt: any }>("/api/receipts", {
          method: "POST",
          body: JSON.stringify({
            storeId: selectedStoreId,
            orderId: order.id,
            cashReceivedMinor: receivedMinor,
            cashierName: principal?.displayName || principal?.email || "Staff"
          })
        }).catch(() => undefined);
      }
    }

    $<HTMLButtonElement>("receipt-print").addEventListener("click", () => window.print());
    $<HTMLButtonElement>("receipt-close").addEventListener("click", () => receiptModal.close());

    /* ---------------------------------------------------------------- */
    /* Cash Shift Management                                            */
    /* ---------------------------------------------------------------- */
    const shiftBtn = $<HTMLButtonElement>("shift-btn");
    const shiftModal = $<HTMLDialogElement>("shift-modal");
    const shiftClose = $<HTMLButtonElement>("shift-close");
    const shiftBody = $<HTMLElement>("shift-body");
    const shiftTitle = $<HTMLElement>("shift-modal-title");
    let currentShift: any = null;

    async function refreshShiftStatus(): Promise<void> {
      if (!selectedStoreId) return;
      try {
        const res = await api<{ session: any }>(`/api/cash-sessions/current?storeId=${encodeURIComponent(selectedStoreId)}`);
        currentShift = res.session;
        const textEl = document.getElementById("shift-status-text");
        if (textEl) {
          if (currentShift && currentShift.status === "OPEN") {
            textEl.textContent = `🟢 กะเปิด (฿${(currentShift.openingAmountMinor / 100).toFixed(2)})`;
          } else {
            textEl.textContent = "🔴 ปิดกะอยู่";
          }
        }
      } catch {
        // Best effort
      }
    }

    function renderShiftModal(): void {
      if (!currentShift || currentShift.status !== "OPEN") {
        shiftTitle.textContent = "เปิดกะการขาย (Opening Shift)";
        shiftBody.innerHTML = `
          <div class="shift-open-form">
            <p class="shift-open-desc">ยังไม่มีกะที่เปิดอยู่ กรุณาระบุเงินทอนเริ่มต้นในลิ้นชักเพื่อเริ่มการขาย</p>
            <label class="shift-field-group">
              <span class="shift-field-label">เงินทอนเริ่มต้น (บาท)</span>
              <input id="shift-open-amount" class="shift-input-amount" type="number" step="1" min="0" value="2000" />
            </label>
            <label class="shift-field-group">
              <span class="shift-field-label">บันทึกเพิ่มเติม</span>
              <input id="shift-open-notes" class="shift-input-text" type="text" placeholder="เช่น กะเช้า / แคชเชียร์ 1" />
            </label>
            <button id="shift-open-submit" class="pos-action-btn pos-pay-btn" type="button">ยืนยันเปิดกะ</button>
          </div>
        `;
        document.getElementById("shift-open-submit")?.addEventListener("click", async () => {
          const input = document.getElementById("shift-open-amount") as HTMLInputElement;
          const notesInput = document.getElementById("shift-open-notes") as HTMLInputElement;
          const amount = Math.round(Number(input?.value || 0) * 100);
          try {
            await api("/api/cash-sessions/open", {
              method: "POST",
              body: JSON.stringify({
                storeId: selectedStoreId,
                openingAmountMinor: amount,
                notes: notesInput?.value || undefined
              })
            });
            showToast("เปิดกะเรียบร้อยแล้ว");
            await refreshShiftStatus();
            renderShiftModal();
          } catch (cause) {
            showToast(friendlyErrorMessage(cause, "เปิดกะไม่สำเร็จ"), true);
          }
        });
        return;
      }

      // Session is OPEN
      const openFloat = (currentShift.openingAmountMinor / 100).toFixed(2);
      const cashSales = ((currentShift.cashSalesMinor || 0) / 100).toFixed(2);
      const expectedTotal = ((currentShift.openingAmountMinor + (currentShift.cashSalesMinor || 0)) / 100).toFixed(2);

      shiftTitle.textContent = "จัดการกะเงินสด (สถานะ: เปิดกะ)";
      shiftBody.innerHTML = `
        <div class="shift-open-form">
          <div class="shift-summary-grid">
            <div><small class="shift-metric-label">เงินทอนเริ่มต้น</small><div class="shift-metric-val">฿${openFloat}</div></div>
            <div><small class="shift-metric-label">ยอดขายเงินสดในกะ</small><div class="shift-metric-val brand">฿${cashSales}</div></div>
            <div class="shift-expected-box">
              <small class="shift-metric-label">ยอดที่คาดว่ามีในลิ้นชัก</small>
              <div class="shift-expected-val">฿${expectedTotal}</div>
            </div>
          </div>

          <details class="shift-movement-details">
            <summary class="shift-movement-summary">💵 นำเงินเข้า / นำเงินออก (Cash In/Out)</summary>
            <div class="shift-movement-fields">
              <select id="movement-type" class="shift-select">
                <option value="PAID_IN">สำรองเงินทอนเพิ่ม (PAID_IN)</option>
                <option value="IN">นำเงินเข้า (IN)</option>
                <option value="PAID_OUT">จ่ายค่าใช้จ่ายหน้าร้าน (PAID_OUT)</option>
                <option value="OUT">นำเงินออก (OUT)</option>
              </select>
              <input id="movement-amount" class="shift-input-text" type="number" min="1" step="1" placeholder="จำนวนเงิน (บาท)" />
              <input id="movement-reason" class="shift-input-text" type="text" placeholder="เหตุผล (เช่น ซื้อน้ำแข็ง)" />
              <button id="movement-submit" class="button secondary" type="button">บันทึกเงินเข้า/ออก</button>
            </div>
          </details>

          <div class="shift-close-section">
            <h4 class="shift-close-title">ปิดกะและตรวจนับเงิน (Close Shift)</h4>
            <label class="shift-field-group">
              <span class="shift-field-label">ยอดเงินสดที่นับได้จริงในลิ้นชัก (บาท)</span>
              <input id="counted-cash" class="shift-input-amount" type="number" min="0" step="0.01" placeholder="0.00" />
            </label>
            <div id="counted-diff" class="shift-diff-badge">ระบุยอดเงินที่นับได้เพื่อคำนวณส่วนต่าง</div>
            <button id="close-shift-submit" class="pos-action-btn shift-close-submit" type="button">ยืนยันปิดกะ</button>
          </div>
        </div>
      `;

      // Wire movement handler
      document.getElementById("movement-submit")?.addEventListener("click", async () => {
        const typeEl = document.getElementById("movement-type") as HTMLSelectElement;
        const amtEl = document.getElementById("movement-amount") as HTMLInputElement;
        const reasonEl = document.getElementById("movement-reason") as HTMLInputElement;
        const amtMinor = Math.round(Number(amtEl?.value || 0) * 100);
        const reason = reasonEl?.value.trim();
        if (!amtMinor || !reason) {
          showToast("กรุณาระบุจำนวนเงินและเหตุผล", true);
          return;
        }
        try {
          await api("/api/cash-sessions/movement", {
            method: "POST",
            body: JSON.stringify({
              storeId: selectedStoreId,
              cashSessionId: currentShift.id,
              movementType: typeEl.value,
              amountMinor: amtMinor,
              reason
            })
          });
          showToast("บันทึกเงินเข้า/ออกแล้ว");
          await refreshShiftStatus();
          renderShiftModal();
        } catch (cause) {
          showToast(friendlyErrorMessage(cause, "บันทึกไม่สำเร็จ"), true);
        }
      });

      // Wire live diff calculation
      const countedInput = document.getElementById("counted-cash") as HTMLInputElement;
      const diffEl = document.getElementById("counted-diff");
      countedInput?.addEventListener("input", () => {
        const counted = Number(countedInput.value || 0);
        const exp = currentShift.openingAmountMinor / 100 + (currentShift.cashSalesMinor || 0) / 100;
        const diff = counted - exp;
        if (diffEl) {
          if (Math.abs(diff) < 0.01) {
            diffEl.textContent = "✅ ยอดเงินตรงกับระบบพอดี (฿0.00)";
            diffEl.style.color = "#23a36d";
          } else if (diff > 0) {
            diffEl.textContent = `⚠️ เงินเกิน +฿${diff.toFixed(2)}`;
            diffEl.style.color = "#b45309";
          } else {
            diffEl.textContent = `❌ เงินขาด -฿${Math.abs(diff).toFixed(2)}`;
            diffEl.style.color = "#dc2626";
          }
        }
      });

      // Wire close shift submit
      document.getElementById("close-shift-submit")?.addEventListener("click", async () => {
        const counted = Number(countedInput?.value || 0);
        if (countedInput && !countedInput.value) {
          showToast("กรุณาระบุยอดเงินที่นับได้", true);
          return;
        }
        if (!window.confirm("ต้องการปิดกะการขายนี้หรือไม่ ยอดขายหลังจากนี้จะต้องเปิดกะใหม่")) return;
        try {
          await api("/api/cash-sessions/close", {
            method: "POST",
            body: JSON.stringify({
              storeId: selectedStoreId,
              cashSessionId: currentShift.id,
              countedAmountMinor: Math.round(counted * 100)
            })
          });
          showToast("ปิดกะเรียบร้อยแล้ว");
          await refreshShiftStatus();
          shiftModal.close();
        } catch (cause) {
          showToast(friendlyErrorMessage(cause, "ปิดกะไม่สำเร็จ"), true);
        }
      });
    }

    shiftBtn.addEventListener("click", async () => {
      await refreshShiftStatus();
      renderShiftModal();
      shiftModal.showModal();
    });

    shiftClose.addEventListener("click", () => shiftModal.close());

    /* ---------------------------------------------------------------- */
    /* Hold / Retrieve                                                  */
    /* ---------------------------------------------------------------- */
    holdBtn.addEventListener("click", async () => {
      if (cart.items.length === 0) return;
      holdBtn.disabled = true;
      try {
        const customerName = $<HTMLInputElement>("customer-name").value.trim();
        cart = setCustomer(cart, customerName, "");
        const orderInput: CreateOrderInput = {
          storeId: selectedStoreId,
          channel: "POS",
          fulfillmentType: cart.fulfillmentType,
          ...(cart.customerName ? { customerName: cart.customerName } : {}),
          items: cart.items.map((item) => ({
            productId: item.productId,
            ...(item.variantId ? { variantId: item.variantId } : {}),
            ...(item.modifiers.length > 0 ? { modifierIds: item.modifiers.map((m) => m.modifierId) } : {}),
            quantity: item.quantity,
            ...(item.note ? { note: item.note } : {})
          }))
        };
        const { order } = await apiWithIdempotency<{ order: OrderSummary }>("/api/orders", "POST", orderInput);
        cart = clearCart(cart);
        $<HTMLInputElement>("customer-name").value = "";
        renderCart();
        showToast(`Hold สำเร็จ: ${order.orderNumber}`);
      } catch (cause) {
        showToast(friendlyErrorMessage(cause, "พักออเดอร์ไม่สำเร็จ กรุณาลองใหม่"), true);
      } finally {
        holdBtn.disabled = false;
      }
    });

    $<HTMLButtonElement>("held-orders-btn").addEventListener("click", async () => {
      const body = $<HTMLElement>("held-body");
      body.innerHTML = '<p class="pos-loading">กำลังโหลด…</p>';
      heldModal.showModal();
      try {
        const { orders } = await api<{ orders: OrderListItem[] }>(
          `/api/orders?storeId=${encodeURIComponent(selectedStoreId)}&status=DRAFT&limit=20`
        );
        if (orders.length === 0) {
          body.innerHTML = '<p class="pos-cart-empty">ไม่มีออเดอร์ที่พัก</p>';
          return;
        }
        body.innerHTML = "";
        for (const order of orders) {
          const row = document.createElement("button");
          row.className = "pos-held-row";
          row.type = "button";
          row.innerHTML = `
            <div>
              <strong>${escapeHtml(order.orderNumber)}</strong>
              <span class="muted">${order.itemCount} รายการ · ${formatMoney(order.totalMinor)}</span>
            </div>
            <span class="pos-held-time">${new Date(order.createdAt).toLocaleTimeString("th-TH", { hour: "2-digit", minute: "2-digit" })}</span>
          `;
          row.addEventListener("click", () => retrieveOrder(order.id));
          body.appendChild(row);
        }
      } catch (cause) {
        body.innerHTML = `<p class="error">${escapeHtml(friendlyErrorMessage(cause, "โหลดออเดอร์ไม่สำเร็จ กรุณาลองใหม่"))}</p>`;
      }
    });

    $<HTMLButtonElement>("held-close").addEventListener("click", () => heldModal.close());

    async function retrieveOrder(orderId: string) {
      try {
        const { order } = await api<{ order: OrderSummary }>(
          `/api/orders/${orderId}?storeId=${encodeURIComponent(selectedStoreId)}`
        );
        // Map order items back to cart items
        cart = createEmptyCart();
        cart = setFulfillmentType(cart, order.fulfillmentType);
        if (order.customerName) cart = setCustomer(cart, order.customerName, order.customerPhone || "");
        for (const item of order.items) {
          const cartItem: CartItem = {
            id: crypto.randomUUID(),
            productId: item.productId,
            variantId: item.variantId,
            productName: item.productName,
            variantName: item.variantName,
            modifiers: item.modifiers.map((m) => ({
              modifierId: m.modifierId,
              modifierGroupId: m.modifierGroupId,
              name: m.name,
              priceDeltaMinor: m.priceDeltaMinor
            })),
            unitPriceMinor: item.unitPriceMinor,
            quantity: item.quantity,
            note: item.note || ""
          };
          cart = addItem(cart, cartItem);
        }
        if (order.customerName) $<HTMLInputElement>("customer-name").value = order.customerName;
        // Update fulfillment UI
        $<HTMLButtonElement>("ft-takeaway").classList.toggle("active", cart.fulfillmentType === "TAKEAWAY");
        $<HTMLButtonElement>("ft-dinein").classList.toggle("active", cart.fulfillmentType === "DINE_IN");
        renderCart();
        heldModal.close();
        showToast(`โหลด ${order.orderNumber} แล้ว`);

        // Cancel the old draft order
        try {
          await apiWithIdempotency("/api/orders/" + orderId + "/transition", "POST", {
            storeId: selectedStoreId,
            toStatus: "CANCELLED",
            expectedStatus: "DRAFT",
            reason: "Retrieved and re-created via POS"
          });
        } catch { /* Best-effort cancel */ }
      } catch (cause) {
        showToast(friendlyErrorMessage(cause, "โหลดออเดอร์ไม่สำเร็จ กรุณาลองใหม่"), true);
      }
    }

    /* ---------------------------------------------------------------- */
    /* Utilities                                                        */
    /* ---------------------------------------------------------------- */
    function showToast(message: string, isError = false) {
      toast.textContent = message;
      toast.className = `pos-toast ${isError ? "pos-toast-error" : "pos-toast-success"}`;
      toast.hidden = false;
      setTimeout(() => { toast.hidden = true; }, 3500);
    }

    function renderCatalogError(message: string, store: StoreSummary): void {
      productsGrid.innerHTML = `<div class="pos-empty-products"><span class="pos-empty-products-icon">!</span><strong>โหลดเมนูไม่สำเร็จ</strong><p>${escapeHtml(message)}</p><button class="button secondary" id="retry-pos-catalog" type="button">ลองใหม่</button></div>`;
      document.querySelector<HTMLButtonElement>("#retry-pos-catalog")?.addEventListener("click", () => void loadCatalogForStore(store));
    }

    function escapeHtml(str: string): string {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }
  </script>

