---
import StaffIcon from "../../components/staff/StaffIcon.astro";
import StaffShell from "../../components/staff/StaffShell.astro";
---

<StaffShell title="ออเดอร์" active="orders">
  <div class="staff-page orders-page">
    <div class="staff-page-header orders-header">
      <div class="staff-page-heading">
        <p class="staff-eyebrow">Orders · Store activity</p>
        <h1 class="staff-page-title">ออเดอร์</h1>
        <p class="staff-page-lede" id="store-summary">กำลังตรวจสอบสิทธิ์และบริบทสาขา</p>
      </div>
      <div class="orders-header-actions">
        <a class="button" id="pos-link" href="#"><StaffIcon name="pos" size={17} />เปิด POS</a>
        <button class="button secondary" id="refresh" type="button"><StaffIcon name="refresh" size={16} />รีเฟรช</button>
      </div>
    </div>

    <p class="error" id="error" role="alert" hidden></p>
    <div class="orders-summary" aria-label="สรุปออเดอร์">
      <div class="orders-summary-item surface"><span class="orders-summary-label">รายการที่โหลด</span><strong id="total-count">—</strong><small>ล่าสุด 100 รายการ</small></div>
      <div class="orders-summary-item surface"><span class="orders-summary-label">กำลังดำเนินการ</span><strong id="open-count">—</strong><small>ยังไม่เสร็จสิ้น</small></div>
      <div class="orders-summary-item surface"><span class="orders-summary-label">พร้อมรับ / เสร็จแล้ว</span><strong id="ready-count">—</strong><small>สถานะปลายทาง</small></div>
      <div class="orders-summary-item surface"><span class="orders-summary-label">ยอดรวมที่แสดง</span><strong id="sales-total">—</strong><small>จากรายการที่โหลด</small></div>
    </div>

    <section class="orders-panel surface" aria-labelledby="orders-heading">
      <div class="orders-panel-heading"><div><span class="staff-eyebrow">Order queue</span><h2 id="orders-heading">รายการล่าสุด</h2></div><span class="orders-panel-note" id="result-count">กำลังโหลด…</span></div>
      <div class="orders-toolbar">
        <label class="orders-search"><StaffIcon name="search" size={17} /><span class="sr-only">ค้นหาออเดอร์</span><input id="search" type="search" placeholder="ค้นหาเลขออเดอร์…" autocomplete="off" /></label>
        <label class="orders-filter"><span>สถานะ</span><select id="status-filter" aria-label="กรองสถานะ"><option value="">ทั้งหมด</option><option value="DRAFT">Draft</option><option value="PENDING_PAYMENT">รอชำระเงิน</option><option value="PAID">ชำระแล้ว</option><option value="CONFIRMED">ยืนยันแล้ว</option><option value="PREPARING">กำลังเตรียม</option><option value="READY">พร้อมรับ</option><option value="COMPLETED">เสร็จสิ้น</option><option value="CANCELLED">ยกเลิก</option></select></label>
      </div>
      <div class="orders-list-wrap" id="orders-list-wrap">
        <div class="orders-table-head" aria-hidden="true"><span>ออเดอร์</span><span>ช่องทาง / เวลา</span><span>รายการ</span><span>ยอดรวม</span><span>สถานะ</span><span></span></div>
        <div class="orders-list" id="orders" aria-live="polite"><div class="orders-loading-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div><div class="orders-loading-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div></div>
      </div>
    </section>
  </div>

  <dialog class="order-dialog" id="order-dialog" aria-labelledby="order-dialog-title">
    <div class="order-dialog-card">
      <div class="order-dialog-heading"><div><span class="staff-eyebrow">Order detail</span><h2 id="order-dialog-title">รายละเอียดออเดอร์</h2></div><button class="staff-icon-button" id="detail-close" type="button" aria-label="ปิด"><StaffIcon name="close" size={18} /></button></div>
      <div class="order-dialog-body" id="order-detail"><div class="empty-state"><p>กำลังโหลดรายละเอียด…</p></div></div>
    </div>
  </dialog>

  <script>
    import { api, ApiError } from "../../lib/api";
    import { friendlyErrorMessage, getSelectedStoreId, findSelectedStore, initStaffShell, loadStaffContext, storeUrl } from "../../lib/staff-ui";
    import type { OrderListItem, OrderStatus, OrderSummary, StoreSummary } from "@aevo/contracts";

    const error = document.querySelector<HTMLParagraphElement>("#error")!;
    const list = document.querySelector<HTMLElement>("#orders")!;
    const search = document.querySelector<HTMLInputElement>("#search")!;
    const statusFilter = document.querySelector<HTMLSelectElement>("#status-filter")!;
    const refresh = document.querySelector<HTMLButtonElement>("#refresh")!;
    const dialog = document.querySelector<HTMLDialogElement>("#order-dialog")!;
    const detail = document.querySelector<HTMLElement>("#order-detail")!;
    const requestedStoreId = getSelectedStoreId();
    let selectedStoreId = "";
    let stores: StoreSummary[] = [];
    let orders: OrderListItem[] = [];
    let lastLoaded = false;
    let ordersLoadVersion = 0;

    function ordersCacheKey(): string {
      return `aevo.staff.orders.v1.${selectedStoreId}.${statusFilter.value || "ALL"}`;
    }

    function readCachedOrders(): OrderListItem[] | null {
      try {
        const raw = sessionStorage.getItem(ordersCacheKey());
        if (!raw) return null;
        const parsed = JSON.parse(raw) as { cachedAt?: number; orders?: OrderListItem[] };
        if (!parsed.cachedAt || Date.now() - parsed.cachedAt > 45_000 || !Array.isArray(parsed.orders)) return null;
        return parsed.orders;
      } catch {
        return null;
      }
    }

    function cacheOrders(nextOrders: OrderListItem[]): void {
      try {
        sessionStorage.setItem(ordersCacheKey(), JSON.stringify({ cachedAt: Date.now(), orders: nextOrders }));
      } catch {
        // Storage is an optimization only; the API remains the source of truth.
      }
    }

    const statusLabels: Record<OrderStatus, string> = {
      DRAFT: "Draft", PENDING_PAYMENT: "รอชำระเงิน", PAID: "ชำระแล้ว", CONFIRMED: "ยืนยันแล้ว", QUEUED: "เข้าคิว", ACCEPTED: "รับงานแล้ว", PREPARING: "กำลังเตรียม", PARTIALLY_READY: "พร้อมบางรายการ", READY: "พร้อมรับ", SERVED: "เสิร์ฟแล้ว", PICKED_UP: "รับสินค้าแล้ว", COMPLETED: "เสร็จสิ้น", CANCELLED: "ยกเลิก", REFUNDED: "คืนเงินแล้ว", PARTIALLY_REFUNDED: "คืนเงินบางส่วน", NO_SHOW: "ไม่มารับ"
    };
    const channelLabels: Record<string, string> = { POS: "หน้าร้าน", QR: "QR", KIOSK: "Kiosk", PICKUP: "รับเอง", STAFF: "Staff", API: "API" };
    const fulfillmentLabels: Record<string, string> = { TAKEAWAY: "ซื้อกลับ", DINE_IN: "ทานที่ร้าน", PICKUP: "รับสินค้า" };

    function money(minor: number, currency: string): string {
      return new Intl.NumberFormat("th-TH", { style: "currency", currency }).format(minor / 100);
    }

    function escapeHtml(value: string): string {
      const element = document.createElement("span");
      element.textContent = value;
      return element.innerHTML;
    }

    function visibleOrders(): OrderListItem[] {
      const needle = search.value.trim().toLowerCase();
      return orders.filter((order) => !needle || `${order.orderNumber} ${order.channel} ${order.fulfillmentType}`.toLowerCase().includes(needle));
    }

    function updateSummary(): void {
      const open = orders.filter((order) => !["COMPLETED", "CANCELLED", "REFUNDED", "PICKED_UP"].includes(order.status)).length;
      const ready = orders.filter((order) => ["READY", "SERVED", "PICKED_UP", "COMPLETED"].includes(order.status)).length;
      const total = orders.reduce((sum, order) => sum + order.totalMinor, 0);
      document.querySelector<HTMLElement>("#total-count")!.textContent = String(orders.length);
      document.querySelector<HTMLElement>("#open-count")!.textContent = String(open);
      document.querySelector<HTMLElement>("#ready-count")!.textContent = String(ready);
      document.querySelector<HTMLElement>("#sales-total")!.textContent = money(total, orders[0]?.currency ?? "THB");
      document.querySelector<HTMLElement>("#result-count")!.textContent = `${visibleOrders().length} รายการ`;
    }

    function render(): void {
      const rows = visibleOrders();
      updateSummary();
      list.replaceChildren();
      if (!rows.length) {
        list.innerHTML = `<div class="empty-state orders-empty"><span class="orders-empty-icon">▤</span><strong>${orders.length ? "ไม่พบออเดอร์ที่ค้นหา" : "ยังไม่มีออเดอร์ในสาขานี้"}</strong><p>${orders.length ? "ลองเปลี่ยนคำค้นหาหรือเลือกสถานะอื่น" : "ออเดอร์จาก POS และช่องทางอื่นจะปรากฏที่นี่"}</p></div>`;
        return;
      }
      const fragment = document.createDocumentFragment();
      for (const order of rows) {
        const row = document.createElement("button");
        row.className = "order-row";
        row.type = "button";
        row.innerHTML = `
          <span class="order-cell order-cell-main"><strong></strong><small></small></span>
          <span class="order-cell"><strong class="order-channel"></strong><small class="order-time"></small></span>
          <span class="order-cell order-cell-items"><strong></strong><small>รายการ</small></span>
          <span class="order-cell order-cell-total"><strong></strong><small>ยอดรวม</small></span>
          <span class="order-status"></span>
          <span class="order-row-arrow" aria-hidden="true">→</span>
        `;
        row.querySelector<HTMLElement>(".order-cell-main strong")!.textContent = order.orderNumber;
        row.querySelector<HTMLElement>(".order-cell-main small")!.textContent = order.paymentStatus === "PAID" ? "ชำระเงินแล้ว" : "ยังไม่ชำระเงิน";
        row.querySelector<HTMLElement>(".order-channel")!.textContent = channelLabels[order.channel] ?? order.channel;
        row.querySelector<HTMLElement>(".order-time")!.textContent = new Date(order.createdAt).toLocaleTimeString("th-TH", { hour: "2-digit", minute: "2-digit" });
        row.querySelector<HTMLElement>(".order-cell-items strong")!.textContent = String(order.itemCount);
        row.querySelector<HTMLElement>(".order-cell-total strong")!.textContent = money(order.totalMinor, order.currency);
        const pill = row.querySelector<HTMLElement>(".order-status")!;
        pill.textContent = statusLabels[order.status] ?? order.status;
        pill.dataset.status = order.status;
        row.addEventListener("click", () => void openOrder(order.id));
        fragment.append(row);
      }
      list.append(fragment);
    }

    function setLoading(loading: boolean): void {
      refresh.disabled = loading;
      statusFilter.disabled = loading;
      if (loading && !lastLoaded) list.innerHTML = '<div class="orders-loading-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div><div class="orders-loading-row"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div>';
    }

    async function loadOrders(): Promise<void> {
      if (!selectedStoreId) return;
      const loadVersion = ++ordersLoadVersion;
      const hadVisibleOrders = lastLoaded;
      setLoading(!hadVisibleOrders);
      const cached = !hadVisibleOrders ? readCachedOrders() : null;
      if (cached) {
        orders = cached;
        lastLoaded = true;
        error.hidden = true;
        render();
      }
      try {
        const query = new URLSearchParams({ storeId: selectedStoreId, limit: "100" });
        if (statusFilter.value) query.set("status", statusFilter.value);
        const result = await api<{ orders: OrderListItem[] }>(`/api/orders?${query}`);
        if (loadVersion !== ordersLoadVersion) return;
        orders = result.orders;
        lastLoaded = true;
        cacheOrders(orders);
        error.hidden = true;
        render();
      } catch (cause) {
        if (loadVersion !== ordersLoadVersion) return;
        error.textContent = friendlyErrorMessage(cause, "โหลดออเดอร์ไม่สำเร็จ กรุณาลองใหม่");
        error.hidden = false;
        if (!lastLoaded) list.innerHTML = `<div class="empty-state orders-empty"><strong>ยังโหลดรายการไม่ได้</strong><p>ตรวจสอบการเชื่อมต่อแล้วลองใหม่อีกครั้ง</p></div>`;
      } finally {
        if (loadVersion === ordersLoadVersion) setLoading(false);
      }
    }

    async function openOrder(orderId: string): Promise<void> {
      detail.innerHTML = '<div class="empty-state"><p>กำลังโหลดรายละเอียด…</p></div>';
      dialog.showModal();
      try {
        const result = await api<{ order: OrderSummary }>(`/api/orders/${encodeURIComponent(orderId)}?storeId=${encodeURIComponent(selectedStoreId)}`);
        const order = result.order;
        const canVoid = order.status !== "CANCELLED" && order.status !== "COMPLETED" && order.status !== "REFUNDED";
        const canRefund = order.status === "PAID" || order.status === "COMPLETED" || order.status === "CONFIRMED";

        detail.innerHTML = `
          <div class="order-detail-meta"><div><span>เลขออเดอร์</span><strong>${escapeHtml(order.orderNumber)}</strong></div><div><span>สถานะ</span><strong class="detail-status" data-status="${order.status}">${escapeHtml(statusLabels[order.status] ?? order.status)}</strong></div><div><span>ประเภท</span><strong>${escapeHtml(fulfillmentLabels[order.fulfillmentType] ?? order.fulfillmentType)}</strong></div><div><span>เวลา</span><strong>${new Date(order.createdAt).toLocaleString("th-TH")}</strong></div></div>
          <div class="order-detail-items">${order.items.map((item) => `<div class="order-detail-item"><div><strong>${escapeHtml(item.productName)}${item.variantName ? ` · ${escapeHtml(item.variantName)}` : ""}</strong><small>${item.quantity} × ${money(item.unitPriceMinor, order.currency)}${item.modifiers.length ? ` · ${item.modifiers.map((modifier) => escapeHtml(modifier.name)).join(", ")}` : ""}</small></div><strong>${money(item.subtotalMinor, order.currency)}</strong></div>`).join("")}</div>
          <div class="order-detail-total"><span>ยอดรวม</span><strong>${money(order.totalMinor, order.currency)}</strong></div>
          ${order.customerName ? `<p class="order-detail-customer">ลูกค้า: ${escapeHtml(order.customerName)}</p>` : ""}
          <div class="order-detail-actions">
            <button id="btn-view-receipt" class="button secondary" type="button">🧾 ใบเสร็จรับเงิน</button>
            ${canVoid ? `<button id="btn-void-order" class="button secondary order-action-void" type="button">🚫 ยกเลิก (Void)</button>` : ""}
            ${canRefund ? `<button id="btn-refund-order" class="button secondary order-action-refund" type="button">💸 คืนเงิน (Refund)</button>` : ""}
          </div>
          <div id="receipt-preview-area" class="receipt-preview-area"></div>
        `;

        // Wire View Receipt
        document.getElementById("btn-view-receipt")?.addEventListener("click", async () => {
          const area = document.getElementById("receipt-preview-area")!;
          area.style.display = "block";
          area.innerHTML = '<p class="receipt-preview-loading">กำลังโหลดใบเสร็จ…</p>';
          try {
            const res = await api<{ receipt: any; thermalText?: string }>(
              `/api/orders/${encodeURIComponent(order.id)}/receipt?storeId=${encodeURIComponent(selectedStoreId)}&format=thermal`
            );
            area.innerHTML = `
              <div class="receipt-thermal-view">${escapeHtml(res.thermalText || JSON.stringify(res.receipt, null, 2))}</div>
              <div class="receipt-actions-row">
                <button id="btn-reprint-receipt" class="button secondary" type="button">🖨️ พิมพ์ซ้ำ (Reprint)</button>
              </div>
            `;
            document.getElementById("btn-reprint-receipt")?.addEventListener("click", async () => {
              try {
                const rep = await api<{ receipt: any; thermalText?: string }>(`/api/receipts/${encodeURIComponent(res.receipt.id)}/reprint`, {
                  method: "POST",
                  body: JSON.stringify({ storeId: selectedStoreId })
                });
                alert(`พิมพ์ซ้ำสำเร็จ (ครั้งที่ ${rep.receipt.reprintCount})`);
                window.print();
              } catch (cause) {
                alert(friendlyErrorMessage(cause, "พิมพ์ซ้ำไม่สำเร็จ"));
              }
            });
          } catch {
            area.innerHTML = `
              <p class="receipt-preview-empty">ยังไม่มีใบเสร็จในระบบ</p>
              <button id="btn-generate-receipt" class="button" type="button">สร้างใบเสร็จตอนนี้</button>
            `;
            document.getElementById("btn-generate-receipt")?.addEventListener("click", async () => {
              try {
                await api("/api/receipts", {
                  method: "POST",
                  body: JSON.stringify({
                    storeId: selectedStoreId,
                    orderId: order.id,
                    cashierName: "Staff"
                  })
                });
                alert("สร้างใบเสร็จเรียบร้อยแล้ว");
                document.getElementById("btn-view-receipt")?.click();
              } catch (cause) {
                alert(friendlyErrorMessage(cause, "สร้างใบเสร็จไม่สำเร็จ"));
              }
            });
          }
        });

        // Wire Void Order
        document.getElementById("btn-void-order")?.addEventListener("click", async () => {
          const reason = window.prompt("กรุณาระบุเหตุผลในการยกเลิกออเดอร์ (Void Reason):", "ลูกค้าขอยกเลิก");
          if (!reason || !reason.trim()) return;
          try {
            await api(`/api/orders/${encodeURIComponent(order.id)}/transition`, {
              method: "POST",
              headers: { "Idempotency-Key": `void-${order.id}-${Date.now()}` },
              body: JSON.stringify({
                storeId: selectedStoreId,
                toStatus: "CANCELLED",
                reason: reason.trim()
              })
            });
            alert("ยกเลิกออเดอร์ (Void) สำเร็จ");
            dialog.close();
            await loadOrders();
          } catch (cause) {
            alert(friendlyErrorMessage(cause, "ยกเลิกออเดอร์ไม่สำเร็จ"));
          }
        });

        // Wire Refund Order
        document.getElementById("btn-refund-order")?.addEventListener("click", async () => {
          const reason = window.prompt("กรุณาระบุเหตุผลในการคืนเงิน (Refund Reason):", "สินค้ามีปัญหา / ลูกค้าขอคืนเงิน");
          if (!reason || !reason.trim()) return;
          try {
            await api(`/api/orders/${encodeURIComponent(order.id)}/transition`, {
              method: "POST",
              headers: { "Idempotency-Key": `refund-${order.id}-${Date.now()}` },
              body: JSON.stringify({
                storeId: selectedStoreId,
                toStatus: "REFUNDED",
                reason: reason.trim()
              })
            });
            alert("บันทึกการคืนเงิน (Refund) สำเร็จ");
            dialog.close();
            await loadOrders();
          } catch (cause) {
            alert(friendlyErrorMessage(cause, "คืนเงินไม่สำเร็จ"));
          }
        });
      } catch (cause) {
        detail.innerHTML = `<div class="empty-state"><strong>โหลดรายละเอียดไม่ได้</strong><p>${escapeHtml(friendlyErrorMessage(cause, "กรุณาลองใหม่อีกครั้ง"))}</p></div>`;
      }
    }

    document.querySelector<HTMLButtonElement>("#detail-close")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    search.addEventListener("input", render);
    statusFilter.addEventListener("change", () => {
      const url = new URL(window.location.href);
      if (statusFilter.value) url.searchParams.set("status", statusFilter.value); else url.searchParams.delete("status");
      history.replaceState(null, "", `${url.pathname}${url.search}`);
      orders = [];
      lastLoaded = false;
      void loadOrders();
    });
    refresh.addEventListener("click", () => void loadOrders());

    async function initialise(): Promise<void> {
      const { user, stores: authorizedStores } = await loadStaffContext();
      stores = authorizedStores;
      const store = findSelectedStore(stores, requestedStoreId);
      if (!store) {
        window.location.assign("/staff");
        return;
      }
      selectedStoreId = store.id;
      sessionStorage.setItem("aevo.selectedStoreId", selectedStoreId);
      const fromUrl = new URLSearchParams(window.location.search).get("status");
      if (fromUrl) statusFilter.value = fromUrl;
      document.querySelector<HTMLElement>("#store-summary")!.textContent = `${store.name} · ${store.code} · ${user.displayName || user.email}`;
      document.querySelector<HTMLAnchorElement>("#pos-link")!.href = storeUrl("/staff/pos", selectedStoreId);
      initStaffShell({
        user,
        stores,
        selectedStoreId,
        onStoreChange: async (nextStoreId) => {
          selectedStoreId = nextStoreId;
          orders = [];
          lastLoaded = false;
          const nextStore = stores.find((item) => item.id === nextStoreId);
          if (!nextStore) return;
          history.replaceState(null, "", storeUrl("/staff/orders", nextStoreId));
          statusFilter.value = "";
          document.querySelector<HTMLElement>("#store-summary")!.textContent = `${nextStore.name} · ${nextStore.code} · ${user.displayName || user.email}`;
          document.querySelector<HTMLAnchorElement>("#pos-link")!.href = storeUrl("/staff/pos", selectedStoreId);
          await loadOrders();
        }
      });
      await loadOrders();
    }

    try {
      await initialise();
    } catch (cause) {
      if (cause instanceof ApiError && cause.code === "UNAUTHORIZED") window.location.assign("/login");
      else { error.textContent = friendlyErrorMessage(cause, "โหลดออเดอร์ไม่สำเร็จ กรุณาลองใหม่"); error.hidden = false; }
    }
  </script>

  <style is:global>
    .orders-header-actions { display: flex; gap: 8px; }
    .orders-summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 28px; }
    .orders-summary-item { display: grid; gap: 3px; padding: 14px 15px; }
    .orders-summary-label { color: var(--muted); font-size: .7rem; font-weight: 760; }
    .orders-summary-item strong { color: var(--ink); font-size: 1.25rem; letter-spacing: -.03em; }
    .orders-summary-item small { color: var(--subtle); font-size: .67rem; }
    .orders-panel { margin-top: 22px; overflow: hidden; }
    .orders-panel-heading { display: flex; align-items: end; justify-content: space-between; gap: 14px; padding: 19px 20px 14px; }
    .orders-panel-heading .staff-eyebrow { margin-bottom: 4px; }
    .orders-panel-heading h2 { margin: 0; font-size: 1.1rem; }
    .orders-panel-note { color: var(--muted); font-size: .73rem; }
    .orders-toolbar { display: flex; align-items: end; gap: 10px; padding: 0 20px 16px; border-bottom: 1px solid var(--line); }
    .orders-search { display: flex; align-items: center; flex: 1; gap: 8px; min-height: 44px; padding: 0 12px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--muted); background: var(--surface); }
